import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/source/tests/LoggingGlobals.bs"
import "pkg:/source/utils/ContentFilters.bs"

namespace Tests

    @suite
    class ChessHandlerTests extends Rooibos.BaseTestSuite

        protected override function beforeEach()
            Tests.SetUpLoggingGlobals()
            m.global.telemetry.LogEvent = {}
        end function

        function CreateService() as object
            return new Invidious.InvidiousService({
                preferences: { "backend.selected": "playlet" }
                apiDefinitions: {
                    search: { url: "/api/v1/search", paginationType: "Pages" }
                }
            })
        end function

        function LiveVideo(videoId as string, title as string, author = "Chess Channel" as string) as object
            return { type: "video", videoId: videoId, title: title, author: author, liveNow: true }
        end function

        function VideoIds(items as object) as object
            result = []
            for each item in items
                result.Push(item.videoId)
            end for
            return result
        end function

        function JsonResponse(body as object) as object
            return new HttpClient.Response({
                statusCode: 200
                headers: {}
                text: FormatJson(body)
            })
        end function

        @describe("ContentFilters.FilterChessItems (liveOnly)")

        @it("keeps live chess videos")
        function _()
            items = [
                m.LiveVideo("a", "Titled Tuesday LIVE", "GMHikaru")
                m.LiveVideo("b", "Candidates 2026 Round 5", "FIDE")
            ]
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, true)), ["a", "b"])
        end function

        @it("drops games that only have chess in their name, in the title or the author")
        function _()
            items = [
                m.LiveVideo("auto", "AUTO CHESS ranked grind")
                m.LiveVideo("autochess", "Autochess live")
                m.LiveVideo("magic", "Magic Chess: Go Go live", "MLBB")
                m.LiveVideo("rush", "Chess Rush tournament")
                m.LiveVideo("dota", "Dota Underlords is back")
                m.LiveVideo("tft", "Climbing to Challenger", "TFT Pro")
                m.LiveVideo("teamfight", "Teamfight Tactics set 15")
                m.LiveVideo("ok", "Chess960 blitz")
            ]
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, true)), ["ok"])
        end function

        @it("doesn't drop a title where tft is only part of a word")
        function _()
            items = [m.LiveVideo("a", "Giftft chess giveaway")]
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, true)), ["a"])
        end function

        @it("drops videos that aren't live, shorts, and items that aren't videos")
        function _()
            items = [
                { type: "video", videoId: "past", title: "Chess stream (replay)", liveNow: false }
                { type: "video", videoId: "unknown", title: "Chess stream" }
                m.LiveVideo("short", "Insane chess trap #Shorts")
                { type: "video", videoId: "flagged", title: "Chess", liveNow: true, isShort: true }
                { type: "channel", videoId: "channel", title: "Chess", liveNow: true }
                invalid
                m.LiveVideo("ok", "Chess live")
            ]
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, true)), ["ok"])
        end function

        @it("drops shows that only have chess in their name and repeated titles")
        function _()
            items = [
                m.LiveVideo("show", "Hank Interrogates Mike Analysed like Chess | Breaking Bad", "Analysed Like Chess")
                m.LiveVideo("game", "One flick and you're hooked! This bouncing chess game is so much fun!#")
                m.LiveVideo("ok", "Candidates 2026 Round 5")
                m.LiveVideo("again", "Candidates 2026 round 5 ")
            ]
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, true)), ["ok"])
        end function

        @describe("ContentFilters.FilterChessItems")

        @it("keeps videos that aren't live unless liveOnly")
        function _()
            items = [
                { type: "video", videoId: "past", title: "To my friend, Daniel Naroditsky", author: "GothamChess" }
                { type: "video", videoId: "magic", title: "Magic Chess tier list" }
                m.LiveVideo("live", "Chess live")
            ]
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, false)), ["past", "live"])
            m.assertEqual(m.VideoIds(ContentFilters.FilterChessItems(items, true)), ["live"])
        end function

        @describe("Invidious.InvidiousService.ChessHandler")

        @it("filters an Invidious search response (an array)")
        function _()
            response = m.JsonResponse([
                m.LiveVideo("a", "Chess live")
                m.LiveVideo("b", "Magic Chess live")
            ])
            result = m.CreateService().ChessHandler({ response: response, feedSource: { liveOnly: true } })
            m.assertEqual(m.VideoIds(result.items), ["a"])
        end function

        @it("keeps videos that aren't live without liveOnly")
        function _()
            response = m.JsonResponse([
                { type: "video", videoId: "past", title: "Chess recap" }
                m.LiveVideo("live", "Chess live")
                m.LiveVideo("magic", "Magic Chess live")
            ])
            result = m.CreateService().ChessHandler({ response: response, feedSource: {} })
            m.assertEqual(m.VideoIds(result.items), ["past", "live"])
        end function

        @it("fails like the default handler for a failed response")
        function _()
            response = new HttpClient.Response({ statusCode: 500, headers: {}, text: "" })
            m.assertInvalid(m.CreateService().ChessHandler({ response: response, feedSource: {} }))
        end function

        @describe("Invidious.InvidiousService.MakeRequest")

        @it("uses the feed source's response handler over the endpoint's")
        function _()
            httpServer = {
                ProcessRequestLocal: function(_method as string, _uri as string, _headers as object, _body as string) as object
                    responseBody = CreateObject("roByteArray")
                    responseBody.FromAsciiString(FormatJson([
                        { type: "video", videoId: "a", title: "Chess live", liveNow: true }
                        { type: "video", videoId: "b", title: "Auto Chess live", liveNow: true }
                    ]))
                    return { http_code: 200, headers: {}, body: responseBody }
                end function
            }
            result = m.CreateService().MakeRequest({ endpoint: "search", responseHandler: "ChessHandler", liveOnly: true }, { httpServer: httpServer })
            m.assertTrue(result.success)
            m.assertEqual(m.VideoIds(result.result.items), ["a"])
        end function

    end class

end namespace
