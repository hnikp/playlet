namespace Tests

    @SGNode("InnertubeTestNode")
    @suite
    class CommentsTests extends Rooibos.BaseTestSuite

        @describe("Innertube comments")

        @it("Parses a comments page into the Invidious shape")
        function _()
            result = m.top@.Innertube_ParseCommentsResponse(m.GetCommentsPageFixture(), "jNQXAC9IVRw")

            m.assertEqual(result.videoId, "jNQXAC9IVRw")
            m.assertEqual(result.continuation, "NEXT_PAGE_TOKEN")
            m.assertEqual(result.comments.Count(), 3)

            pinned = result.comments[0]
            m.assertEqual(pinned.commentId, "UgzuC3zzpRZkjc5Qzsd4AaABAg")
            m.assertEqual(pinned.author, "@SanDiegoZoo")
            m.assertEqual(pinned.authorId, "UCC5NfQ6Mf0dq_eEwv4P_hWA")
            m.assertEqual(pinned.content, "We're so honored that the first ever YouTube video was filmed here!")
            m.assertEqual(pinned.publishedText, "6 years ago")
            m.assertTrue(pinned.isPinned)
            m.assertFalse(pinned.isEdited)
            m.assertEqual(pinned.likeCountText, "4.8M")
            m.assertEqual(pinned.likeCount, 4800000)
            m.assertNotInvalid(pinned.creatorHeart)
            m.assertEqual(pinned.replies.replyCount, 985)
            m.assertEqual(pinned.replies.continuation, "REPLIES_TOKEN_0")
            m.assertEqual(pinned.authorThumbnails.Count(), 1)

            unhearted = result.comments[2]
            m.assertFalse(unhearted.isPinned)
            m.assertInvalid(unhearted.creatorHeart)
        end function

        @it("Parses a replies page")
        function _()
            result = m.top@.Innertube_ParseCommentsResponse(m.GetRepliesPageFixture(), "jNQXAC9IVRw")

            m.assertEqual(result.comments.Count(), 1)
            m.assertEqual(result.continuation, "MORE_REPLIES_TOKEN")

            reply = result.comments[0]
            m.assertEqual(reply.author, "@TheGreekPianist")
            m.assertTrue(reply.isEdited)
            m.assertInvalid(reply.replies)
        end function

        @it("Handles an invalid payload")
        function _()
            result = m.top@.Innertube_ParseCommentsResponse(invalid, "abc")
            m.assertEqual(result.comments.Count(), 0)
            m.assertInvalid(result.continuation)
        end function

        @it("Parses abbreviated counts")
        @params("985", 985)
        @params("1,234", 1234)
        @params("304K", 304000)
        @params("4.8M", 4800000)
        @params("", 0)
        @params(invalid, 0)
        function _(text as dynamic, expected as integer)
            m.assertEqual(m.top@.Innertube_ParseAbbreviatedCount(text), expected)
        end function

