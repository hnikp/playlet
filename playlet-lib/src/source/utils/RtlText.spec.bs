namespace Tests

    @suite
    class RtlTextTests extends Rooibos.BaseTestSuite

        @describe("RtlText.ContainsArabicScript")

        @it("Detects Arabic-script text")
        @params("Hello world", false)
        @params("", false)
        @params(invalid, false)
        @params("سلام", true)
        @params("iPhone 15 جدید", true)
        @params("۱۴۰۳", true)
        function _(text as dynamic, expected as boolean)
            m.assertEqual(RtlText.ContainsArabicScript(text), expected)
        end function

        @describe("RtlText.NeedsBundledFont")

        @it("Detects Arabic-script text and emoji")
        @params("Hello world", false)
        @params(invalid, false)
        @params("سلام", true)
        @params("Goal 😀", true)
        @params("I ❤ it", true)
        @params("Gấu mèo TV", true)
        @params("Café crème", false)
        function _(text as dynamic, expected as boolean)
            m.assertEqual(RtlText.NeedsBundledFont(text), expected)
        end function

        @describe("RtlText.CleanEmoji")

        @it("Drops the parts of emoji sequences Roku can't combine")
        function _()
            m.assertEqual(RtlText.CleanEmoji("Hello"), "Hello")
            m.assertEqual(RtlText.CleanEmoji(invalid), "")
            m.assertEqual(RtlText.CleanEmoji("I " + Chr(&h2764) + Chr(&hFE0F) + " it"), "I " + Chr(&h2764) + " it")
            m.assertEqual(RtlText.CleanEmoji(Chr(&h1F44D) + Chr(&h1F3FD)), Chr(&h1F44D))
            m.assertEqual(RtlText.CleanEmoji("Iran " + Chr(&h1F1EE) + Chr(&h1F1F7)), "Iran ")
            m.assertEqual(RtlText.CleanEmoji(Chr(&h1F468) + Chr(&h200D) + Chr(&h1F469)), Chr(&h1F468) + Chr(&h1F469))
            ' a ZWNJ/ZWJ in Persian text is kept
            m.assertEqual(RtlText.CleanEmoji("می" + Chr(&h200C) + "روم 😀"), "می" + Chr(&h200C) + "روم 😀")
        end function

        @describe("RtlText.Prepare")

        @it("Leaves text without special characters as it is")
        function _()
            prepared = RtlText.Prepare("Hello (world)", m.FakeMeasurer(), 100, 2)
            m.assertEqual(prepared.text, "Hello (world)")
            m.assertFalse(prepared.useBundledFont)
            m.assertFalse(prepared.isRtl)
        end function

        @it("Uses the bundled font unscaled for emoji and Vietnamese letters")
        function _()
            measurer = m.FakeMeasurer()
            prepared = RtlText.Prepare("Goal " + Chr(&h1F600) + Chr(&hFE0F), measurer, 100, 2)
            m.assertEqual(prepared.text, "Goal " + Chr(&h1F600))
            m.assertTrue(prepared.useBundledFont)
            m.assertFalse(prepared.hasArabic)
            m.assertEqual(prepared.fontScale, RtlText.LATIN_FONT_SCALE)
            ' not wrapped (the label wraps it)
            m.assertEqual(measurer.calls, 0)

            prepared = RtlText.Prepare("Gấu mèo TV")
            m.assertTrue(prepared.useBundledFont)
            m.assertEqual(prepared.fontScale, RtlText.LATIN_FONT_SCALE)
        end function

        @it("Shapes, wraps and reorders Arabic script, scaled")
        function _()
            ' "ا د ا د" (alef, dal: no joining) at 10px per character, 30px per line: "ا د" per line
            text = m.Cps([&h0627, &h20, &h062F, &h20, &h0627, &h20, &h062F])
            prepared = RtlText.Prepare(text, m.FakeMeasurer(), 30, 2)
            line = m.Cps([&hFEA9, &h20, &hFE8D])
            m.assertEqual(prepared.text, line + Chr(10) + line)
            m.assertTrue(prepared.isRtl)
            m.assertTrue(prepared.useBundledFont)
            m.assertTrue(prepared.hasArabic)
            m.assertEqual(prepared.fontScale, RtlText.FONT_SCALE)
        end function

        @it("Cuts long text before shaping, keeping the ellipsis")
        function _()
            words = []
            for i = 1 to 1000
                words.Push(Chr(&h0627))
            end for
            measurer = m.FakeMeasurer()
            ' 40px, one line: "ا ا…" fits
            prepared = RtlText.Prepare(words.Join(" "), measurer, 40, 1)
            m.assertEqual(prepared.text, m.Cps([&h2026, &hFE8D, &h20, &hFE8D]))
            m.assertTrue(measurer.calls < 20)
        end function

        @it("Ends cut text with an ellipsis")
        function _()
            ' 5 characters at most (1 * 16 / 4 + 1) are shaped, and the line ends with an ellipsis
            text = m.Cps([&h0627, &h0627, &h0627, &h0627, &h0627, &h0627, &h0627, &h0627])
            prepared = RtlText.Prepare(text, m.FakeMeasurer(), 16, 1)
            m.assertEqual(prepared.text, Chr(&h2026))
        end function

        @describe("RtlText.PrepareForLabel")

        @it("Remembers the label size it was prepared for")
        function _()
            prepared = RtlText.PrepareForLabel("Goal " + Chr(&h1F600), 18, true, 350, 2)
            m.assertTrue(prepared.useBundledFont)
            m.assertEqual(prepared.width, 350)
            m.assertEqual(prepared.maxLines, 2)

            prepared = RtlText.PrepareForLabel("Hello", 18, true, 350, 2)
            m.assertFalse(prepared.useBundledFont)
            m.assertEqual(prepared.text, "Hello")
        end function

        @describe("RtlText.IsPreparedFor")

        @it("Compares the size of Arabic-script text only")
        function _()
            label = { width: 350, maxLines: 2, wrap: true }
            m.assertTrue(RtlText.IsPreparedFor({ hasArabic: true, width: 350, maxLines: 2 }, label))
            m.assertFalse(RtlText.IsPreparedFor({ hasArabic: true, width: 350, maxLines: 2 }, { width: 260, maxLines: 3, wrap: true }))
            m.assertFalse(RtlText.IsPreparedFor({ hasArabic: true, width: 350, maxLines: 2 }, { width: 350, maxLines: 2, wrap: false }))
            m.assertTrue(RtlText.IsPreparedFor({ hasArabic: false, width: 350, maxLines: 2 }, { width: 260, maxLines: 3, wrap: true }))
        end function

        @describe("RtlText fonts")

        @it("Scales the bundled font for Arabic script only")
        function _()
            m.assertEqual(RtlText.FontScaleFor(true), RtlText.FONT_SCALE)
            m.assertEqual(RtlText.FontScaleFor(false), RtlText.LATIN_FONT_SCALE)
            m.assertEqual(RtlText.ScaledFontSize(18), 16)
            m.assertEqual(RtlText.ScaledFontSize(18, RtlText.LATIN_FONT_SCALE), 18)
            m.assertNotEqual(RtlText.FontKey(18, false, RtlText.FONT_SCALE), RtlText.FontKey(18, false, RtlText.LATIN_FONT_SCALE))
        end function

        @it("Takes size and boldness from system font names")
        @params("font:SmallestBoldSystemFont", 0, invalid, 18, true)
        @params("font:SmallestSystemFont", 0, invalid, 18, false)
        @params("font:MediumBoldSystemFont", 0, invalid, 24, true)
        @params("font:SmallSystemFont", 0, invalid, 22, false)
        @params("font:LargeBoldSystemFont", 0, invalid, 30, true)
        @params("font:SmallestBoldSystemFont", 30, false, 30, false)
        @params("font:UnknownFont", 0, invalid, 24, false)
        @params(invalid, 0, true, 24, true)
        function _(fontName as dynamic, size as integer, bold as dynamic, expectedSize as integer, expectedBold as boolean)
            info = RtlText.ResolveFontInfo(fontName, size, bold)
            m.assertEqual(info.size, expectedSize)
            m.assertEqual(info.bold, expectedBold)
        end function

        ' Measures 10px per character and counts measurements
        function FakeMeasurer() as object
            return {
                calls: 0
                GetOneLineWidth: function(text as string, _maxWidth as integer) as float
                    m.calls += 1
                    return Len(text) * 10
                end function
            }
        end function

        function Cps(cps as object) as string
            return ArabicShaping.FromCodePoints(cps)
        end function

    end class

end namespace
