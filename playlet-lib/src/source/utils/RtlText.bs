import "pkg:/source/utils/ArabicShaping.bs"
import "pkg:/source/utils/Types.bs"

' Arabic-script (Persian/Arabic) text, emoji and Vietnamese letters in SceneGraph labels.
' The text work (analysis, shaping, bidi, wrapping) is in ArabicShaping.bs; this module picks fonts and sets
' labels. The bundled Vazirmatn font covers the presentation forms needed by Persian and Arabic. It also has
' Noto Emoji's black-and-white emoji and Noto Sans' Vietnamese letters (tools/build-emoji-fonts.py): the system
' font has neither, so labels with them use it too.
namespace RtlText
    const FONT_REGULAR_URI = "pkg:/fonts/Vazirmatn-Regular.ttf"
    const FONT_BOLD_URI = "pkg:/fonts/Vazirmatn-Bold.ttf"
    const FONT_REGULAR_FILE = "libpkg:/fonts/Vazirmatn-Regular.ttf"
    const FONT_BOLD_FILE = "libpkg:/fonts/Vazirmatn-Bold.ttf"
    const FONT_FAMILY = "Vazirmatn"
    ' Vazirmatn's Arabic script looks larger (and its lines are taller) than the system font at the same size.
    ' Its Latin letters and emoji match the system font's size unscaled.
    const FONT_SCALE = 0.9
    const LATIN_FONT_SCALE = 1.0
    ' Size of the bundled font when nothing else tells it
    const DEFAULT_FONT_SIZE = 24
    ' A RowList's default row label font size
    const ROW_LABEL_FONT_SIZE = 26

    function ContainsArabicScript(text as dynamic) as boolean
        return ArabicShaping.ContainsArabicScript(text)
    end function

    ' True if the text needs the bundled font: Arabic-script letters, emoji or Vietnamese letters.
    function NeedsBundledFont(text as dynamic) as boolean
        return ArabicShaping.Analyze(text).needsBundledFont
    end function

    ' Removes the parts of emoji sequences that would show as boxes (see ArabicShaping.IsEmojiSequenceCodePoint).
    function CleanEmoji(text as dynamic) as string
        return ArabicShaping.Analyze(text).text
    end function

    ' The bundled font's scale for text with (or without) Arabic script
    function FontScaleFor(hasArabic as boolean) as float
        if hasArabic
            return FONT_SCALE
        end if
        return LATIN_FONT_SCALE
    end function

    ' Shapes + wraps + reorders text for display. Returns { text, isRtl, useBundledFont, fontScale, hasArabic }:
    ' text is ready to assign to a label, in the bundled font at fontScale when useBundledFont is true.
    ' font (something with GetOneLineWidth, see GetMeasureFont) is optional: without it the text is not wrapped.
    function Prepare(text as dynamic, font = invalid as object, maxWidth = 0 as integer, maxLines = 1 as integer) as object
        return PrepareAnalyzed(ArabicShaping.Analyze(text), font, maxWidth, maxLines)
    end function

    ' Prepare for text already analyzed (ArabicShaping.Analyze).
    function PrepareAnalyzed(analysis as object, font as object, maxWidth as integer, maxLines as integer) as object
        text = analysis.text
        prepared = {
            text: text
            isRtl: false
            useBundledFont: analysis.needsBundledFont
            fontScale: FontScaleFor(analysis.hasArabic)
            hasArabic: analysis.hasArabic
        }
        if not analysis.hasArabic
            return prepared
        end if

        wrap = font <> invalid and maxWidth > 0
        truncated = false
        if wrap
            ' a long description would be shaped in full for a few visible lines
            cut = ArabicShaping.Truncate(text, ArabicShaping.MaxVisibleChars(maxWidth, maxLines))
            text = cut.text
            truncated = cut.truncated
        end if

        paragraphs = ArabicShaping.Shape(text).Split(Chr(10))
        lastParagraph = paragraphs.Count() - 1
        lines = []
        for i = 0 to lastParagraph
            remaining = maxLines - lines.Count()
            if remaining <= 0
                exit for
            end if
            if wrap
                lines.Append(ArabicShaping.Wrap(paragraphs[i], font, maxWidth, remaining, truncated and i = lastParagraph))
            else
                lines.Push(paragraphs[i])
            end if
        end for

        visualLines = []
        for each line in lines
            visualLines.Push(ArabicShaping.ToVisualLine(line))
        end for

        prepared.text = visualLines.Join(Chr(10))
        prepared.isRtl = analysis.isRtl
        return prepared
    end function

    ' Prepare, measuring with the bundled font at the given size (only measured for Arabic script, which is
    ' wrapped here; other text is wrapped by the label).
    function PrepareSized(text as dynamic, size as integer, bold as boolean, maxWidth as integer, maxLines as integer) as object
        analysis = ArabicShaping.Analyze(text)
        measurer = invalid
        if analysis.hasArabic
            measurer = GetMeasureFont(size, bold, FONT_SCALE)
        end if
        return PrepareAnalyzed(analysis, measurer, maxWidth, maxLines)
    end function

    ' For text prepared in a task thread and shown later in a label (see SetLabelText): returns
    ' { text, isRtl, useBundledFont, fontScale, hasArabic, width, maxLines }. When useBundledFont is true, the
    ' label should use GetLabelFont(size, bold, fontScale) and horizAlign "right" if isRtl.
    function PrepareForLabel(text as dynamic, size as integer, bold as boolean, width as integer, maxLines as integer) as object
        ' see ApplyToLabel for the slack
        prepared = PrepareSized(text, size, bold, Int(width * 0.95), maxLines)
        ' the label size it was wrapped for
        prepared.width = width
        prepared.maxLines = maxLines
        return prepared
    end function

    ' Sets text on a Label, switching to the bundled font for Arabic-script text, emoji or Vietnamese letters and
    ' back to defaultFont otherwise. The label's width and maxLines are honored.
    ' defaultFont is a Font node or a font name ("font:SmallestSystemFont"). size and bold are those of the
    ' bundled font; by default they come from the system font name (see SystemFontInfo) or the Font node's size.
    function ApplyToLabel(label as object, text as dynamic, defaultFont as dynamic, bold = invalid as dynamic, size = 0 as integer) as void
        if label = invalid
            return
        end if
        analysis = ArabicShaping.Analyze(text)
        if not analysis.needsBundledFont
            SetDefaultFont(label, defaultFont)
            label.horizAlign = "left"
            label.text = analysis.text
            return
        end if

        fontInfo = ResolveFontInfo(defaultFont, size, bold)
        maxLines = 1
        if label.wrap
            maxLines = label.maxLines
            if maxLines <= 0
                maxLines = 50
            end if
        end if

        measurer = invalid
        if analysis.hasArabic
            measurer = GetMeasureFont(fontInfo.size, fontInfo.bold, FONT_SCALE)
        end if
        ' a little slack: SceneGraph and roFont measurements can differ by a few pixels, and an overflowing
        ' line would be re-wrapped by the label in the wrong order.
        prepared = PrepareAnalyzed(analysis, measurer, Int(label.width * 0.95), maxLines)
        ShowPrepared(label, prepared, fontInfo.size, fontInfo.bold)
    end function

    ' Sets a label's text, using text prepared in a task thread (PrepareForLabel) when available, so the render
    ' thread doesn't shape/wrap. Without prepared text, or text prepared for another label size, it is prepared
    ' here (ApplyToLabel). size and bold: see ApplyToLabel.
    function SetLabelText(label as object, text as dynamic, prepared as dynamic, defaultFont as dynamic, size = 0 as integer, bold = invalid as dynamic) as void
        if not IsAssociativeArray(prepared) or not prepared.DoesExist("useBundledFont")
            ApplyToLabel(label, text, defaultFont, bold, size)
            return
        end if
        if prepared.useBundledFont <> true
            SetDefaultFont(label, defaultFont)
            label.horizAlign = "left"
            label.text = prepared.text
            return
        end if
        if not IsPreparedFor(prepared, label)
            ApplyToLabel(label, text, defaultFont, bold, size)
            return
        end if
        fontInfo = ResolveFontInfo(defaultFont, size, bold)
        ShowPrepared(label, prepared, fontInfo.size, fontInfo.bold)
    end function

    ' True if prepared text was wrapped for the label's width and lines (text without Arabic script isn't wrapped)
    function IsPreparedFor(prepared as object, label as object) as boolean
        if prepared.hasArabic <> true or not prepared.DoesExist("width")
            return true
        end if
        maxLines = 1
        if label.wrap
            maxLines = label.maxLines
        end if
        return prepared.width = label.width and prepared.maxLines = maxLines
    end function

    function ShowPrepared(label as object, prepared as object, size as integer, bold as boolean) as void
        fontScale = prepared.fontScale
        if fontScale = invalid
            fontScale = FONT_SCALE
        end if
        SetRtlFont(label, size, bold, fontScale)
        if prepared.isRtl = true
            label.horizAlign = "right"
        else
            label.horizAlign = "left"
        end if
        label.text = prepared.text
    end function

    ' Vazirmatn's lines are much taller than the system font's (~38px vs ~28px at size 18), which pushes the
    ' labels below a multi-line title out of their cell: tighten the line spacing while it is used.
    function SetRtlFont(label as object, size as integer, bold as boolean, fontScale = FONT_SCALE as float) as void
        if not label.hasField("rtlDefaultLineSpacing")
            label.addField("rtlDefaultLineSpacing", "float", false)
            label.rtlDefaultLineSpacing = label.lineSpacing
        end if
        label.font = GetLabelFont(size, bold, fontScale)
        label.lineSpacing = label.rtlDefaultLineSpacing - Int(ScaledFontSize(size, fontScale) * 0.5)
    end function

    function SetDefaultFont(label as object, defaultFont as dynamic) as void
        if defaultFont <> invalid
            label.font = defaultFont
        end if
        if label.hasField("rtlDefaultLineSpacing")
            label.lineSpacing = label.rtlDefaultLineSpacing
        end if
    end function

    ' The font for a label showing prepared text (Prepare): the bundled font at the system font's size, or the
    ' system font (a name like "font:SmallestBoldSystemFont").
    function FontFor(fontName as string, prepared as object) as dynamic
        if prepared.useBundledFont <> true
            return fontName
        end if
        fontInfo = ResolveFontInfo(fontName, 0, invalid)
        return GetLabelFont(fontInfo.size, fontInfo.bold, prepared.fontScale)
    end function

    ' Sets a ButtonGroup's buttons. A ButtonGroup has one font for all buttons: when a text needs the bundled
    ' font, the whole group uses it (focused buttons in bold), else the group's own fonts.
    ' textWidth: the width the texts are wrapped (ellipsized) to.
    function SetButtonGroupTexts(group as object, texts as object, size as integer, textWidth as integer) as void
        buttonTexts = []
        useBundledFont = false
        hasArabic = false
        for each text in texts
            prepared = PrepareSized(text, size, false, textWidth, 1)
            buttonTexts.Push(prepared.text)
            useBundledFont = useBundledFont or prepared.useBundledFont
            hasArabic = hasArabic or prepared.hasArabic
        end for

        fontScale = FontScaleFor(hasArabic)
        SwitchFontField(group, "textFont", useBundledFont, size, false, fontScale)
        SwitchFontField(group, "focusedTextFont", useBundledFont, size, true, fontScale)
        group.buttons = buttonTexts
    end function

    ' Returns a copy of a RowList's feeds ([{ title, ... }]) with the titles prepared, and switches the RowList's
    ' row label font: the bundled font when a title needs it, else its own font.
    function PrepareRowListFeeds(rowList as object, feeds as object, size = ROW_LABEL_FONT_SIZE as integer) as object
        result = []
        useBundledFont = false
        hasArabic = false
        for each feed in feeds
            if not IsAssociativeArray(feed) or not IsString(feed.title)
                result.Push(feed)
                continue for
            end if
            ' a copy: preparing prepared (visual order) text again would reverse it back
            copy = {}
            copy.Append(feed)
            prepared = Prepare(feed.title)
            copy.title = prepared.text
            useBundledFont = useBundledFont or prepared.useBundledFont
            hasArabic = hasArabic or prepared.hasArabic
            result.Push(copy)
        end for
        SwitchFontField(rowList, "rowLabelFont", useBundledFont, size, false, FontScaleFor(hasArabic))
        return result
    end function

    ' Sets a node's font field to the bundled font, or back to the field's original value (saved on the node
    ' the first time, like SetRtlFont's line spacing).
    function SwitchFontField(node as object, fieldName as string, useBundledFont as boolean, size as integer, bold as boolean, fontScale as float) as void
        defaultField = "rtlDefault_" + fieldName
        if not node.hasField(defaultField)
            node.addField(defaultField, "node", false)
            node[defaultField] = node[fieldName]
        end if
        if useBundledFont
            node[fieldName] = GetLabelFont(size, bold, fontScale)
        else if node[defaultField] <> invalid
            node[fieldName] = node[defaultField]
        end if
    end function

    ' Size and boldness of the system fonts at the app's (HD) resolution, so callers can pass just the name.
    function SystemFontInfo(fontName as string) as dynamic
        fonts = m.__rtlSystemFonts
        if fonts = invalid
            fonts = {
                "font:SmallestSystemFont": { size: 18, bold: false }
                "font:SmallestBoldSystemFont": { size: 18, bold: true }
                "font:SmallSystemFont": { size: 22, bold: false }
                "font:SmallBoldSystemFont": { size: 22, bold: true }
                "font:MediumSystemFont": { size: 24, bold: false }
                "font:MediumBoldSystemFont": { size: 24, bold: true }
                "font:LargeSystemFont": { size: 30, bold: false }
                "font:LargeBoldSystemFont": { size: 30, bold: true }
            }
            m.__rtlSystemFonts = fonts
        end if
        return fonts[fontName]
    end function

    ' { size, bold } of the bundled font standing in for defaultFont: explicit size (> 0) and bold (a boolean)
    ' win, else they come from the system font name or the Font node's size.
    function ResolveFontInfo(defaultFont as dynamic, size as integer, bold as dynamic) as object
        info = invalid
        if IsString(defaultFont)
            info = SystemFontInfo(defaultFont)
        end if
        if size <= 0
            size = DEFAULT_FONT_SIZE
            if info <> invalid
                size = info.size
            else if IsNode(defaultFont) and defaultFont.size > 0
                size = defaultFont.size
            end if
        end if
        if not IsBool(bold)
            bold = info <> invalid and info.bold
        end if
        return { size: size, bold: bold }
    end function

    function ScaledFontSize(size as integer, fontScale = FONT_SCALE as float) as integer
        return Int(size * fontScale + 0.5)
    end function

    function FontKey(size as integer, bold as boolean, fontScale as float) as string
        return `${size}_${bold}_${Int(fontScale * 100 + 0.5)}`
    end function

    ' A SceneGraph Font node for the bundled font, cached per thread.
    function GetLabelFont(size as integer, bold as boolean, fontScale = FONT_SCALE as float) as object
        cache = m.__rtlLabelFonts
        if cache = invalid
            cache = {}
            m.__rtlLabelFonts = cache
        end if
        key = FontKey(size, bold, fontScale)
        font = cache[key]
        if font = invalid
            font = CreateObject("roSGNode", "Font")
            if bold
                font.uri = FONT_BOLD_URI
            else
                font.uri = FONT_REGULAR_URI
            end if
            font.size = ScaledFontSize(size, fontScale)
            cache[key] = font
        end if
        return font
    end function

    ' Something with GetOneLineWidth(text, maxWidth) to measure text in the bundled font, cached per thread.
    ' roFontRegistry can't be created on the render thread, so there a hidden Label measures instead.
    function GetMeasureFont(size as integer, bold as boolean, fontScale = FONT_SCALE as float) as object
        cache = m.__rtlMeasureFonts
        if cache = invalid
            cache = {}
            m.__rtlMeasureFonts = cache
        end if
        key = FontKey(size, bold, fontScale)
        measurer = cache[key]
        if measurer <> invalid
            return measurer
        end if

        if IsRenderThread()
            measurer = CreateLabelMeasurer(GetLabelFont(size, bold, fontScale))
        else
            registry = GetFontRegistry(bold)
            if registry = invalid
                return invalid
            end if
            measurer = registry.GetFont(FONT_FAMILY, ScaledFontSize(size, fontScale), bold, false)
        end if

        if measurer = invalid
            return invalid
        end if
        cache[key] = measurer
        return measurer
    end function

    ' The thread's roFontRegistry with the needed weight registered: each font file is ~900KB, and jobs
    ' (new nodes, so a new registry each time) often need only one weight.
    function GetFontRegistry(bold as boolean) as object
        registry = m.__rtlFontRegistry
        if registry = invalid
            registry = CreateObject("roFontRegistry")
            if registry = invalid
                return invalid
            end if
            m.__rtlFontRegistry = registry
            m.__rtlRegisteredFonts = {}
        end if
        file = FONT_REGULAR_FILE
        if bold
            file = FONT_BOLD_FILE
        end if
        if m.__rtlRegisteredFonts[file] = invalid
            registry.Register(file)
            m.__rtlRegisteredFonts[file] = true
        end if
        return registry
    end function

    ' Jobs run in Task nodes (m.top is a Task); components run on the render thread.
    function IsRenderThread() as boolean
        if m.__rtlIsRenderThread = invalid
            m.__rtlIsRenderThread = IsNode(m.top) and not m.top.isSubtype("Task")
        end if
        return m.__rtlIsRenderThread
    end function

    function CreateLabelMeasurer(labelFont as object) as object
        measureLabel = CreateObject("roSGNode", "Label")
        measureLabel.font = labelFont
        measureLabel.wrap = false
        return {
            label: measureLabel
            GetOneLineWidth: function(text as string, _maxWidth as integer) as float
                m.label.text = text
                return m.label.boundingRect().width
            end function
        }
    end function
end namespace
