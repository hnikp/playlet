namespace Tests

    @suite
    class SensitivePreferencesTests extends Rooibos.BaseTestSuite

        @describe("SensitivePreferences.Mask")

        @it("hides short values completely and shows the end of long ones")
        function _()
            m.assertEqual(SensitivePreferences.Mask(""), "")
            m.assertEqual(SensitivePreferences.Mask(invalid), "")
            m.assertEqual(SensitivePreferences.Mask("short"), "••••")
            m.assertEqual(SensitivePreferences.Mask("sk-1234567890abcd"), "••••abcd")
            m.assertTrue(SensitivePreferences.IsMasked("••••abcd"))
            m.assertFalse(SensitivePreferences.IsMasked("sk-real"))
        end function

        @describe("SensitivePreferences.DropMaskedValues")

        @it("never saves a mask over the real value")
        function _()
            keys = { "ai_search.api_key": true }
            payload = { "ai_search.api_key": "••••abcd", "ai_search.model": "x" }
            SensitivePreferences.DropMaskedValues(payload, keys)
            m.assertFalse(payload.DoesExist("ai_search.api_key"))
            m.assertEqual(payload["ai_search.model"], "x")
        end function

        @describe("SensitivePreferences.ClearValuesBoundToChanges")

        @it("clears the key when the provider or server url changes")
        function _()
            current = { "ai_search.provider": "gemini", "ai_search.base_url": "" }
            payload = { "ai_search.provider": "custom", "ai_search.base_url": "http://evil/v1" }
            SensitivePreferences.ClearValuesBoundToChanges(payload, current)
            m.assertEqual(payload["ai_search.api_key"], "")

            payload = { "ai_search.base_url": "http://evil/v1", "ai_search.api_key": "••••abcd" }
            SensitivePreferences.ClearValuesBoundToChanges(payload, current)
            m.assertEqual(payload["ai_search.api_key"], "", "a mask is not a new key")
        end function

        @it("clears the key when the value that comes along is not a new key")
        function _()
            current = { "ai_search.provider": "gemini", "ai_search.base_url": "" }
            for each badValue in [0, true, invalid, {}, [], ""]
                payload = { "ai_search.provider": "custom", "ai_search.api_key": badValue }
                cleared = SensitivePreferences.ClearValuesBoundToChanges(payload, current)
                m.assertEqual(payload["ai_search.api_key"], "")
                m.assertEqual(cleared, ["ai_search.api_key"])
            end for
        end function

        @it("keeps the key when nothing it is bound to changes, or a new key comes along")
        function _()
            current = { "ai_search.provider": "gemini", "ai_search.base_url": "" }
            payload = { "ai_search.provider": "gemini", "ai_search.model": "flash" }
            cleared = SensitivePreferences.ClearValuesBoundToChanges(payload, current)
            m.assertFalse(payload.DoesExist("ai_search.api_key"))
            m.assertEqual(cleared, [])

            payload = { "ai_search.provider": "groq", "ai_search.api_key": "gsk-new" }
            SensitivePreferences.ClearValuesBoundToChanges(payload, current)
            m.assertEqual(payload["ai_search.api_key"], "gsk-new")
        end function

    end class

end namespace
