import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/CancellationUtils.bs"
import "pkg:/source/utils/ContentFilters.bs"
import "pkg:/source/utils/RtlText.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/TimeUtils.bs"
import "pkg:/source/utils/Types.bs"

' YouTube auto-translates video titles into the request's language (a Spanish video shows up in English) and its
' API has no flag against it: feed and search results only carry the translated title. The oEmbed endpoint
' answers with the original one, a small request per video.
' Titles are kept in one store shared by the jobs (the Invidious node's originalTitles field, saved to a single
' cachefs file), so a video is looked up once a week, and a video without an answer (private, embedding disabled)
' once a day. When lookups time out or fail (offline, rate limited), all of them pause for a while (the Invidious
' node's originalTitlesPausedUntil field).
' Feeds only take the stored titles (ApplyStored) and look the others up after they are shown (OriginalTitlesJob).
namespace OriginalTitles
    const OEMBED_URL = "https://www.youtube.com/oembed"
    const PARALLEL_REQUESTS = 10
    const ATTEMPT_TIMEOUT_MS = 4000
    const TITLE_MAX_AGE_SECONDS = 604800
    const MISS_MAX_AGE_SECONDS = 86400
    const PAUSE_SECONDS = 600
    const MAX_ENTRIES = 2000
    ' the file is rewritten once this many new titles came in (and when the store is pruned)
    const SAVE_EVERY = 25
    const STORE_FILE = "cachefs:/original_titles_v1.json"

    ' Only with the built-in backend: whoever picked an Invidious instance doesn't want requests to YouTube.
    function IsEnabled(preferences as object) as boolean
        if preferences = invalid or preferences["browsing.original_titles"] = false
            return false
        end if
        backend = preferences["backend.selected"]
        return backend = invalid or backend = "playlet"
    end function

    ' Replaces the title of each video in items (Invidious API items, or a video's metadata) with its original
    ' title, looking up the ones not stored. Videos without one keep theirs. storeNode: the node with the
    ' originalTitles field (Invidious). Blocks: task threads only.
    function Apply(items as object, storeNode as object, cancellation = invalid as dynamic) as void
        missingIds = ApplyStored(items, storeNode)
        titles = Lookup(missingIds, storeNode, cancellation)
        if titles.Count() = 0
            return
        end if
        for each video in GetVideos(items)
            title = titles[video.videoId]
            if IsString(title) and title <> ""
                video.title = title
            end if
        end for
    end function

    ' Apply without requests: only the stored titles. Returns the ids of the videos to look up (none while
    ' lookups are paused).
    function ApplyStored(items as object, storeNode as object) as object
        missingIds = []
        videos = GetVideos(items)
        if videos.Count() = 0
            return missingIds
        end if

        store = LoadStore(storeNode)
        nowSeconds = TimeUtils.NowSeconds()
        paused = IsPaused(GetPausedUntil(storeNode), nowSeconds)
        missingDict = {}
        for each video in videos
            entry = store.entries[video.videoId]
            if IsFresh(entry, nowSeconds)
                if entry[0] <> ""
                    video.title = entry[0]
                end if
            else if not paused and not missingDict.DoesExist(video.videoId)
                missingDict[video.videoId] = true
                missingIds.Push(video.videoId)
            end if
        end for
        return missingIds
    end function

    ' Looks the titles up and stores them. Returns { videoId: title }, "" for the videos without an answer.
    ' Blocks: task threads only.
    function Lookup(videoIds as object, storeNode as object, cancellation = invalid as dynamic) as object
        if videoIds.Count() = 0 or IsPaused(GetPausedUntil(storeNode), TimeUtils.NowSeconds())
            return {}
        end if

        fetched = Fetch(videoIds, cancellation)
        nowSeconds = TimeUtils.NowSeconds()
        if ShouldPause(fetched.failures, fetched.answers) and storeNode <> invalid
            storeNode.originalTitlesPausedUntil = nowSeconds + PAUSE_SECONDS
        end if

        titles = fetched.titles
        if titles.Count() > 0
            ' read again: another job may have added titles meanwhile
            store = LoadStore(storeNode)
            for each videoId in titles
                store.entries[videoId] = [titles[videoId], nowSeconds]
            end for
            store.unsaved += titles.Count()
            SaveStore(storeNode, store, nowSeconds)
        end if
        return titles
    end function

    ' Puts titles ({ videoId: title }, from Lookup) in the video content nodes shown with the translated ones,
    ' with their label text prepared like InvidiousContent.ToVideoContentNode's.
    function SetNodeTitles(nodes as dynamic, titles as object) as void
        if titles.Count() = 0
            return
        end if
        for each node in ValidArray(nodes)
            if node.type <> "video"
                continue for
            end if
            title = titles[node.videoId]
            if IsString(title) and title <> "" and title <> node.title
                ' both at once: a row cell drawn in between would get a title and a prepared text that don't match
                node.setFields({
                    title: title
                    titlePrepared: RtlText.PrepareForLabel(title, 18, true, 350, 2)
                })
            end if
        end for
    end function

    function GetVideos(items as dynamic) as object
        videos = []
        for each item in ValidArray(items)
            if IsAssociativeArray(item) and ContentFilters.IsVideoItem(item) and IsString(item.videoId) and item.videoId <> ""
                videos.Push(item)
            end if
        end for
        return videos
    end function

    function GetPausedUntil(storeNode as object) as integer
        if storeNode = invalid
            return 0
        end if
        return ValidInt(storeNode.originalTitlesPausedUntil)
    end function

    function IsPaused(pausedUntilSeconds as integer, nowSeconds as integer) as boolean
        return nowSeconds < pausedUntilSeconds
    end function

    ' Lookups pause when at least as many requests failed (timeout, network, server error, rate limit) as were
    ' answered: one slow request among answered ones is only retried at the next load.
    function ShouldPause(failures as integer, answers as integer) as boolean
        return failures > 0 and failures >= answers
    end function

    ' entry: [title, savedAtSeconds]; title "" for a video without an answer
    function IsFresh(entry as dynamic, nowSeconds as integer) as boolean
        if not IsArray(entry) or entry.Count() < 2 or not IsString(entry[0])
            return false
        end if
        maxAge = TITLE_MAX_AGE_SECONDS
        if entry[0] = ""
            maxAge = MISS_MAX_AGE_SECONDS
        end if
        return nowSeconds - ValidInt(entry[1]) < maxAge
    end function

    ' Looks the titles up, PARALLEL_REQUESTS at a time (a new request starts as soon as one ends).
    ' Returns { titles: { videoId: title }, answers, failures }: "" for the videos without an answer; a failed or
    ' cancelled request isn't in titles, and a cancelled one isn't counted.
    function Fetch(videoIds as object, cancellation as dynamic) as object
        titles = {}
        answers = 0
        failures = 0
        port = CreateObject("roMessagePort")
        active = []
        nextIndex = 0
        count = videoIds.Count()
        while nextIndex < count or active.Count() > 0
            if CancellationUtils.IsCancelled(cancellation)
                for each entry in active
                    entry.fetch.Cancel()
                end for
                exit while
            end if
            while active.Count() < PARALLEL_REQUESTS and nextIndex < count
                videoId = videoIds[nextIndex]
                active.Push({ videoId: videoId, fetch: CreateRequest(videoId).SendOn(port) })
                nextIndex += 1
            end while

            waitMs = 1000
            for each entry in active
                entryWaitMs = entry.fetch.MaxWaitMs()
                if entryWaitMs < waitMs
                    waitMs = entryWaitMs
                end if
            end for
            message = wait(waitMs, port)

            for i = active.Count() - 1 to 0 step -1
                response = active[i].fetch.Handle(message)
                if response <> invalid
                    title = ParseTitle(response)
                    if title <> "" or IsMissingVideo(response)
                        titles[active[i].videoId] = title
                        answers += 1
                    else if not response.IsSuccess() and not response.IsCancelled()
                        failures += 1
                    end if
                    active.Delete(i)
                end if
            end for
        end while
        return { titles: titles, answers: answers, failures: failures }
    end function

    function CreateRequest(videoId as string) as object
        request = HttpClient.Get(OEMBED_URL)
        request.QueryParam("format", "json")
        request.QueryParam("url", "https://www.youtube.com/watch?v=" + videoId)
        request.AttemptTimeoutMs(ATTEMPT_TIMEOUT_MS)
        request.RetryCount(0)
        ' the store is the cache: no file per video
        request.NoCache()
        ' 401/404 for videos that can't be embedded or are private: expected, not worth reporting
        request.NoTelemetry()
        return request
    end function

    function ParseTitle(response as object) as string
        if response = invalid or not response.IsSuccess()
            return ""
        end if
        json = response.Json()
        if not IsAssociativeArray(json) or not IsString(json.title)
            return ""
        end if
        return json.title.Trim()
    end function

    ' oEmbed's answer for a private video or one that can't be embedded: worth remembering (for a day)
    function IsMissingVideo(response as object) as boolean
        statusCode = response.StatusCode()
        return statusCode = 400 or statusCode = 401 or statusCode = 403 or statusCode = 404
    end function

    ' { entries: { videoId: [title, savedAtSeconds] }, unsaved }: from the node, or from the file the first time
    function LoadStore(storeNode as object) as object
        store = invalid
        if storeNode <> invalid
            store = storeNode.originalTitles
        end if
        if IsAssociativeArray(store) and IsAssociativeArray(store.entries)
            return store
        end if

        store = { entries: {}, unsaved: 0 }
        fileSystem = CreateObject("roFileSystem")
        if fileSystem.Exists(STORE_FILE)
            entries = StringUtils.ParseJsonSafe(ReadAsciiFile(STORE_FILE))
            if IsAssociativeArray(entries)
                store.entries = entries
            end if
        end if
        if storeNode <> invalid
            storeNode.originalTitles = store
        end if
        return store
    end function

    function SaveStore(storeNode as object, store as object, nowSeconds as integer) as void
        if store.entries.Count() > MAX_ENTRIES and Prune(store.entries, nowSeconds) > 0
            store.unsaved = SAVE_EVERY
        end if
        if store.unsaved >= SAVE_EVERY
            if WriteAsciiFile(STORE_FILE, FormatJson(store.entries))
                store.unsaved = 0
            end if
        end if
        if storeNode <> invalid
            storeNode.originalTitles = store
        end if
    end function

    ' Drops the expired entries, then, if still more than maxEntries, keeps the newest three quarters of
    ' maxEntries. Returns how many were dropped.
    function Prune(entries as object, nowSeconds as integer, maxEntries = MAX_ENTRIES as integer) as integer
        removed = 0
        for each videoId in entries.Keys()
            if not IsFresh(entries[videoId], nowSeconds)
                entries.Delete(videoId)
                removed += 1
            end if
        end for
        if entries.Count() <= maxEntries
            return removed
        end if

        bySavedAt = []
        for each videoId in entries
            bySavedAt.Push({ videoId: videoId, savedAt: ValidInt(entries[videoId][1]) })
        end for
        bySavedAt.SortBy("savedAt", "r")
        for i = maxEntries * 3 \ 4 to bySavedAt.Count() - 1
            entries.Delete(bySavedAt[i].videoId)
            removed += 1
        end for
        return removed
    end function
end namespace
