import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/RtlText.bs"
import "pkg:/source/utils/Types.bs"

const FONT_SIZE = 18

function Init()
    m.highlight = m.top.findNode("highlight")
    m.authorThumbnail = m.top.findNode("authorThumbnail")
    m.authorLabel = m.top.findNode("authorLabel")
    m.contentLabel = m.top.findNode("contentLabel")
    m.footerLabel = m.top.findNode("footerLabel")
    m.regularFont = m.top.findNode("regularFont")
    m.boldFont = m.top.findNode("boldFont")
end function

function OnContentSet() as void
    content = m.top.itemContent
    if content = invalid
        return
    end if

    m.authorThumbnail.uri = content.authorThumbnail

    author = content.author
    if content.publishedText <> ""
        author += " • " + content.publishedText
    end if
    RtlText.SetLabelText(m.authorLabel, author, content.authorPrepared, m.boldFont, FONT_SIZE, true)
    RtlText.SetLabelText(m.contentLabel, content.content, content.contentPrepared, m.regularFont, FONT_SIZE, false)

    m.footerLabel.text = CommentsFooterText(content)
end function

function CommentsFooterText(content as object) as string
    parts = []
    if content.isPinned
        parts.Push(Tr(Locale.Comments.Pinned))
    end if
    if content.likeCountText <> "" and content.likeCountText <> "0"
        parts.Push(Tr(Locale.Comments.NLikes).Replace("%1", content.likeCountText))
    end if
    if content.replyCount = 1
        parts.Push(Tr(Locale.Comments.OneReply))
    else if content.replyCount > 1
        parts.Push(Tr(Locale.Comments.NReplies).Replace("%1", content.replyCount.ToStr()))
    end if
    return parts.Join(" • ")
end function

function OnFocusPercent()
    m.highlight.opacity = m.top.focusPercent
end function
