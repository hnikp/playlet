import "pkg:/components/JobSystem/Jobs.bs"
import "pkg:/components/JobSystem/JobSystem.bs"
import "pkg:/components/VideoQueue/VideoQueueUtils.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/TimeUtils.bs"
import "pkg:/source/utils/Types.bs"

' Thumbnail previews of VideoRowList (same component scope): after focus stays on a video for
' PREVIEW_DELAY_SECONDS, its storyboard frames (StoryboardPreviewJob) or the video itself (VideoPreviewJob,
' played in a single Video node that VideoRowCell places over the thumbnail) are loaded and shown.
' State (set in VideoRowList.Init): m.previewNode, m.previewJob, m.previewVideo, m.previewVideoItem.

const PREVIEW_DELAY_SECONDS = 2
' a seek past the end of a live stream lands on its live edge (TransportController.LIVE_EDGE_SEEK_MS, in seconds)
const LIVE_EDGE_SEEK_SECONDS = 999999

' Restarts the preview delay for the newly focused item (not upcoming videos; live ones only as video,
' they have no storyboard frames)
function SchedulePreview(item as object) as void
    StopPreview()
    if item = invalid or item.type <> "video" or item.isUpcoming
        return
    end if
    mode = m.preferences["misc.thumbnail_preview_mode"]
    if mode <> "frames" and mode <> "video"
        LogDebug("Thumbnail preview off:", mode)
        return
    end if
    if item.liveNow and mode <> "video"
        return
    end if

    m.previewNode = item
    if m.previewTimer = invalid
        m.previewTimer = CreateObject("roSGNode", "Timer")
        m.previewTimer.duration = PREVIEW_DELAY_SECONDS
        m.previewTimer.repeat = false
        m.previewTimer.ObserveFieldScoped("fire", FuncName(OnPreviewTimerFire))
    end if
    m.previewTimer.control = "start"
end function

function OnPreviewTimerFire() as void
    item = m.previewNode
    if item = invalid or not m.top.hasFocus() or not m.top.visible
        LogDebug("Thumbnail preview skipped: focus=", m.top.hasFocus(), " visible=", m.top.visible)
        return
    end if
    LogDebug("Thumbnail preview for", item.videoId)
    ' no previews over a fullscreen video (the list isn't visible anyway)
    if VideoQueueUtils.IsVideoPlayerOpen(m.videoQueue) and VideoQueueUtils.IsVideoPlayerFullScreen(m.videoQueue)
        return
    end if

    ' Roku can't decode two videos: with a player open (e.g. picture-in-picture) only frames are shown
    if m.preferences["misc.thumbnail_preview_mode"] = "video" and not VideoQueueUtils.IsVideoPlayerOpen(m.videoQueue)
        QueueVideoPreviewJob(item)
    else if not item.liveNow
        QueueStoryboardPreviewJob(item)
    end if
end function

function QueueStoryboardPreviewJob(item as object)
    m.previewJob = JobSystem.CreateCallback(OnStoryboardPreviewJobDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.StoryboardPreviewJob, {
        invidious: m.invidious
        videoId: item.videoId
    }, m.previewJob)
    m.storyboardPreviewItem = item
end function

function OnStoryboardPreviewJobDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    ' a stale job (focus moved on, StopPreview cancelled it) must not set frames
    if m.previewJob = invalid or not m.previewJob.isSameNode(event.getRoSGNode())
        return
    end if
    m.previewJob = invalid
    item = m.storyboardPreviewItem
    m.storyboardPreviewItem = invalid

    info = event.getInfo()
    if not info.success
        if not info.cancel
            LogDebug("No thumbnail preview:", info.error)
        end if
        return
    end if
    if item = invalid or m.previewNode = invalid or not item.isSameNode(m.previewNode)
        return
    end if
    item.previewStoryboard = info.data
end function

function QueueVideoPreviewJob(item as object)
    m.previewJob = JobSystem.CreateCallback(OnVideoPreviewJobDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.VideoPreviewJob, {
        invidious: m.invidious
        innertube: m.innertube
        preferences: m.preferences
        profilesService: m.profilesService
        loungeService: m.loungeService
        playletServerPort: m.webServer.port
        videoId: item.videoId
    }, m.previewJob)
end function

function OnVideoPreviewJobDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    ' a stale job (focus moved on, StopPreview cancelled it) must not start anything
    if m.previewJob = invalid or not m.previewJob.isSameNode(event.getRoSGNode())
        return
    end if
    m.previewJob = invalid

    info = event.getInfo()
    if info.cancel
        return
    end if

    item = m.previewNode
    if item = invalid or not m.top.hasFocus() or not m.top.visible
        return
    end if

    if not info.success
        if item.liveNow
            LogDebug("No live thumbnail preview:", info.error)
            return
        end if
        LogDebug("No video thumbnail preview, falling back to frames:", info.error)
        QueueStoryboardPreviewJob(item)
        return
    end if

    data = info.data
    ' frames show while the video buffers, and stay if it fails
    if IsAssociativeArray(data.frames)
        item.previewStoryboard = data.frames
    end if

    ' only frames were usable; a player may also have opened while the job ran
    if StringUtils.IsNullOrEmpty(data.url) or VideoQueueUtils.IsVideoPlayerOpen(m.videoQueue)
        return
    end if
    PlayPreviewVideo(item, data)
end function

function GetPreviewVideo() as object
    if m.previewVideo = invalid
        player = CreateObject("roSGNode", "Video")
        player.enableUI = false
        if player.hasField("enableTrickPlay")
            player.enableTrickPlay = false
        end if
        ' only hides the captions of this node; globalCaptionMode is a device-wide setting, left alone
        player.suppressCaptions = true
        player.loop = false
        player.ObserveFieldScoped("state", FuncName(OnPreviewVideoState))
        m.previewVideo = player
    end if
    return m.previewVideo
end function

function PlayPreviewVideo(item as object, data as object) as void
    player = GetPreviewVideo()
    player.mute = not (m.preferences["misc.thumbnail_preview_sound"] = true)

    streamContent = CreateObject("roSGNode", "ContentNode")
    streamContent.url = data.url
    streamContent.streamFormat = data.streamFormat
    ' a live stream starts at its live edge
    streamContent.live = data.live = true

    m.previewVideoItem = item
    if data.streamFormat = "dash"
        ' the local web server builds the DASH manifest from this (VideoQueue.previewContent)
        dashSource = CreateObject("roSGNode", "ContentNode")
        dashSource.addFields({ videoLoadId: data.videoLoadId, metadata: data.metadata })
        m.videoQueue.previewContent = dashSource
    end if

    player.content = streamContent
    ' VideoRowCell picks the node up here and places it over the thumbnail: RowList item components are not
    ' descendants of the RowList.
    ' Only one preview plays at a time, so one global slot is enough.
    if not m.global.hasField("thumbnailPreviewPlayer")
        m.global.addField("thumbnailPreviewPlayer", "node", false)
    end if
    m.global.thumbnailPreviewPlayer = player
    item.previewVideoActive = true
    if streamContent.live
        ' like the main player (VideoPlayerDev.SeekToInitialPosition): a live DASH manifest lists the whole DVR
        ' window and would otherwise start hours behind; seeking past the end lands on the live edge
        player.seek = LIVE_EDGE_SEEK_SECONDS
    end if
    player.control = "play"

    limitMinutes = m.preferences["misc.thumbnail_preview_limit"]
    if IsNumber(limitMinutes) and limitMinutes > 0
        if m.previewLimitTimer = invalid
            m.previewLimitTimer = CreateObject("roSGNode", "Timer")
            m.previewLimitTimer.repeat = false
            m.previewLimitTimer.ObserveFieldScoped("fire", FuncName(OnPreviewLimitTimerFire))
        end if
        m.previewLimitTimer.duration = limitMinutes * 60
        m.previewLimitTimer.control = "start"
    end if
end function

function OnPreviewVideoState() as void
    if m.previewVideoItem = invalid
        return
    end if
    state = m.previewVideo.state
    if state = "error"
        LogDebug("Video thumbnail preview error:", m.previewVideo.errorMsg)
        ' frames (if any) keep animating
        StopPreviewVideo()
    else if state = "finished"
        StopPreview()
    end if
end function

function OnPreviewLimitTimerFire()
    StopPreview()
end function

' A real player opened (e.g. from the web app or a cast): it can't share the decoder with the preview
function OnVideoPlayerChange() as void
    if VideoQueueUtils.IsVideoPlayerOpen(m.videoQueue)
        StopPreviewVideo()
    end if
end function

' Hands the preview's position to the queue, so playing the selected video soon resumes from it
' (VideoQueue.ApplyPreviewResume). Selecting without a playing preview clears an older handoff.
function RememberPreviewPosition() as void
    item = m.previewVideoItem
    player = m.previewVideo
    if item = invalid or player = invalid or item.liveNow = true or player.position < 1
        m.videoQueue.previewResume = {}
        return
    end if
    m.videoQueue.previewResume = {
        videoId: item.videoId
        seconds: Int(player.position)
        atSeconds: TimeUtils.NowSeconds()
    }
end function

' Synchronous on purpose: the preview video must be stopped before a real player starts
function StopPreviewVideo() as void
    if m.previewLimitTimer <> invalid
        m.previewLimitTimer.control = "stop"
    end if
    if m.previewVideoItem = invalid
        return
    end if
    player = m.previewVideo
    player.control = "stop"
    player.content = invalid
    parent = player.getParent()
    if parent <> invalid
        parent.removeChild(player)
    end if
    m.previewVideoItem.previewVideoActive = false
    m.previewVideoItem = invalid
    m.videoQueue.previewContent = invalid
    ' the global slot would otherwise keep this list's Video node (and its observers) after the list is disposed
    globalPlayer = m.global.thumbnailPreviewPlayer
    if globalPlayer <> invalid and globalPlayer.isSameNode(player)
        m.global.thumbnailPreviewPlayer = invalid
    end if
end function

' Stops the preview of the previously focused item and frees its frames (VideoRowCell stops animating)
function StopPreview() as void
    if m.previewTimer <> invalid
        m.previewTimer.control = "stop"
    end if
    if m.previewJob <> invalid
        m.previewJob.cancel = true
        m.previewJob = invalid
    end if
    StopPreviewVideo()
    if m.previewNode <> invalid
        m.previewNode.previewStoryboard = {}
        m.previewNode = invalid
    end if
end function
