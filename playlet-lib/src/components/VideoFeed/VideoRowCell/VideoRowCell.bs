import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/RtlText.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/TimeUtils.bs"
import "pkg:/source/utils/Types.bs"

const THUMBNAIL_WIDTH = 350
const THUMBNAIL_HEIGHT = 196

function Init()
    m.durationRect = m.top.FindNode("durationRect")
    m.durationLabel = m.top.FindNode("durationLabel")
    m.smallestSystemFont = m.top.FindNode("smallestSystemFont")
    m.smallestBoldSystemFont = m.top.FindNode("smallestBoldSystemFont")
    m.progressRect = m.top.FindNode("progressRect")
    m.titleLabel = m.top.FindNode("titleLabel")
    m.authorLabel = m.top.FindNode("authorLabel")
    m.previewGroup = m.top.FindNode("previewGroup")
    m.previewPoster = m.top.FindNode("previewPoster")
    m.previewTimer = m.top.FindNode("previewTimer")
    m.previewTimer.ObserveField("fire", FuncName(OnPreviewTimerFire))
    m.previewPoster.ObserveField("loadStatus", FuncName(OnPreviewLoadStatus))
    m.previewContent = invalid
    m.previewVideo = invalid
end function

function OnContentSet() as void
    content = m.top.itemContent
    ObservePreview(content)

    if content = invalid
        return
    end if

    RtlText.SetLabelText(m.titleLabel, content.title, content.titlePrepared, "font:SmallestBoldSystemFont", 18, true)
    lines = content.lines

    ' NOTE: "_author" not "author". See PlaylistContentNode.xml for explanation.
    author = content._author
    if StringUtils.IsNullOrEmpty(author)
        if IsArray(lines) and lines.Count() > 0
            author = lines[0]
        end if
    end if
    RtlText.SetLabelText(m.authorLabel, author, content.authorPrepared, "font:SmallestSystemFont", 18, false)

    viewCountDate = ""
    if content.isUpcoming = true
        viewCountDate = content.premiereTimestampText
    else
        publishedText = content.publishedText
        viewCountText = content.viewCountText

        label = publishedText
        if publishedText.Len() > 0 and viewCountText.Len() > 0
            label += " • "
        end if
        label += viewCountText

        viewCountDate = label
    end if
    if StringUtils.IsNullOrEmpty(viewCountDate)
        if IsArray(lines) and lines.Count() > 1
            viewCountDate = lines[1]
        end if
    end if
    m.top.viewCountDate = viewCountDate

    m.top.thumbnailUri = content.thumbnail

    m.top.percentDurationWatched = content.percentDurationWatched

    if not StringUtils.IsNullOrEmpty(content.lengthText)
        SetDurationLabel(content.lengthText, "#161616FF", 0.8, m.smallestSystemFont)
        m.top.durationRectVisible = true
    else
        if content.isUpcoming = true
            SetDurationLabel(Tr(Locale.RowCell.Upcoming), "#161616FF", 0.8, m.smallestBoldSystemFont)
            m.top.durationRectVisible = true
        else if content.liveNow
            SetDurationLabel(Tr(Locale.RowCell.Live), "#CC0000FF", 0.9, m.smallestBoldSystemFont)
            m.top.durationRectVisible = true
        else
            m.top.durationRectVisible = false
        end if
    end if
end function

function SetDurationLabel(text as string, bgColor as string, bgOpacity as float, font as object) as void
    m.top.duration = text

    label = m.durationLabel
    rect = m.durationRect

    if label = invalid or rect = invalid
        return
    end if

    rectParent = rect.getParent()
    label.font = font

    size = label.localBoundingRect()

    rect.width = size.width + 16
    rect.translation = [rectParent.width - rect.width, rect.translation[1]]
    rect.color = bgColor
    rect.opacity = bgOpacity
end function

' Cells are recycled: follow the preview fields of the current content node only
function ObservePreview(content as object) as void
    if m.previewContent <> invalid
        if content <> invalid and m.previewContent.isSameNode(content)
            return
        end if
        m.previewContent.unobserveFieldScoped("previewStoryboard")
        m.previewContent.unobserveFieldScoped("previewVideoActive")
    end if
    m.previewContent = content
    if content <> invalid and content.hasField("previewStoryboard")
        content.observeFieldScoped("previewStoryboard", FuncName(OnPreviewChange))
    end if
    if content <> invalid and content.hasField("previewVideoActive")
        content.observeFieldScoped("previewVideoActive", FuncName(OnPreviewVideoChange))
    end if
    OnPreviewChange()
    ' also drops another item's video when the cell is recycled
    OnPreviewVideoChange()
end function

function OnPreviewChange() as void
    m.previewTimer.control = "stop"
    m.previewPoster.visible = false
    m.previewFrames = invalid

    content = m.previewContent
    if content = invalid or not content.hasField("previewStoryboard")
        m.previewPoster.uri = ""
        return
    end if
    preview = content.previewStoryboard
    if not IsAssociativeArray(preview) or not IsArray(preview.frames) or preview.frames.Count() = 0
        ' release the sheet bitmap
        m.previewPoster.uri = ""
        return
    end if

    m.previewFrames = preview.frames
    m.previewFrameIndex = 0
    ShowPreviewFrame()
    m.previewTimer.control = "start"
end function

function OnPreviewTimerFire() as void
    if m.previewFrames = invalid
        return
    end if
    m.previewFrameIndex = (m.previewFrameIndex + 1) mod m.previewFrames.Count()
    ShowPreviewFrame()
end function

' The sheet is scaled so one tile = the thumbnail size; translation + clippingRect select the tile
function ShowPreviewFrame() as void
    frame = m.previewFrames[m.previewFrameIndex]
    cellX = frame.col * THUMBNAIL_WIDTH
    cellY = frame.row * THUMBNAIL_HEIGHT
    m.previewPoster.width = frame.cols * THUMBNAIL_WIDTH
    m.previewPoster.height = frame.rows * THUMBNAIL_HEIGHT
    m.previewPoster.translation = [-cellX, -cellY]
    m.previewPoster.clippingRect = [cellX, cellY, THUMBNAIL_WIDTH, THUMBNAIL_HEIGHT]
    if m.previewPoster.uri <> frame.url
        ' hidden until the new sheet loads (OnPreviewLoadStatus)
        m.previewPoster.visible = false
        m.previewPoster.uri = frame.url
        return
    end if
    ' a frame from an already loaded sheet shows right away; a new sheet shows once loaded
    if m.previewPoster.loadStatus = "ready"
        m.previewPoster.visible = true
    end if
end function

function OnPreviewLoadStatus() as void
    if m.previewFrames <> invalid and m.previewPoster.loadStatus = "ready"
        m.previewPoster.visible = true
    end if
end function

' The preview's Video node, owned by the VideoRowList that set previewVideoActive
function FindPreviewPlayer() as dynamic
    if not m.global.hasField("thumbnailPreviewPlayer")
        return invalid
    end if
    return m.global.thumbnailPreviewPlayer
end function

' The Video node (owned by VideoRowList) is placed over the frames, covering the thumbnail
function OnPreviewVideoChange() as void
    newVideo = invalid
    content = m.previewContent
    if content <> invalid and content.hasField("previewVideoActive") and content.previewVideoActive = true
        newVideo = FindPreviewPlayer()
    end if

    if m.previewVideo <> invalid
        if newVideo <> invalid and m.previewVideo.isSameNode(newVideo)
            return
        end if
        DetachPreviewVideo()
    end if
    if newVideo = invalid
        return
    end if

    m.previewVideo = newVideo
    ' an unstarted Video may draw black: hidden until it plays (frames show meanwhile)
    newVideo.visible = false
    newVideo.width = THUMBNAIL_WIDTH
    newVideo.height = THUMBNAIL_HEIGHT
    newVideo.translation = [0, 0]
    ' another cell may still hold it (recycling order is not guaranteed)
    oldParent = newVideo.getParent()
    if oldParent <> invalid
        oldParent.removeChild(newVideo)
    end if
    ' appended after previewPoster, so drawn above it
    m.previewGroup.appendChild(newVideo)
    newVideo.observeFieldScoped("state", FuncName(OnPreviewVideoState))
    OnPreviewVideoState()
end function

function OnPreviewVideoState() as void
    if m.previewVideo = invalid or m.previewVideo.state <> "playing"
        return
    end if
    m.previewVideo.visible = true
    ' the frames are covered now
    m.previewTimer.control = "stop"
end function

function DetachPreviewVideo() as void
    previewVideo = m.previewVideo
    m.previewVideo = invalid
    previewVideo.unobserveFieldScoped("state")
    parent = previewVideo.getParent()
    if parent <> invalid and parent.isSameNode(m.previewGroup)
        m.previewGroup.removeChild(previewVideo)
    end if
    ' e.g. the video failed: the frames take over again
    if m.previewFrames <> invalid
        m.previewTimer.control = "start"
    end if
end function

function OnPercentDurationWatched() as void
    if m.progressRect = invalid
        return
    end if

    percent = MathUtils.Clamp(m.top.percentDurationWatched, 0, 100) / 100.0
    m.progressRect.scale = [percent, 1]
end function
