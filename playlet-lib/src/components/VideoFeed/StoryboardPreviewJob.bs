import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/source/services/HttpClient.bs"
import "pkg:/source/utils/StoryboardUtils.bs"
import "pkg:/source/utils/Types.bs"

' Fetches the storyboards of a video and returns its thumbnail preview frames (JobSuccessData). VideoRowList sets
' them on the content node (VideoContentNode.previewStoryboard), which VideoRowCell animates, if the video still has
' the focus: a job cancelled late would otherwise animate a cell that lost it.
' Failures are expected (shorts, new uploads, offline) and not reported to telemetry.
@job("StoryboardPreviewJob")
function ExecuteJob() as void
    input = JobGetInput()

    if JobIsCancelled()
        JobCancel()
        return
    end if

    service = new Invidious.InvidiousService(input.invidious)
    instance = service.GetInstance()
    ' fields= keeps the Invidious response small (the built-in backend ignores it)
    request = HttpClient.Get(`${instance}${Invidious.VIDEOS_ENDPOINT}/${input.videoId}`)
    request.QueryParam("fields", "storyboards")
    request.CacheForSeconds(3600)
    request.Cancellation(JobGetCancellation())
    response = request.Await()

    if JobIsCancelled()
        JobCancel()
        return
    end if

    if not response.IsSuccess()
        JobErrorNoTelemetry("Failed to load storyboards: " + response.ErrorMessage())
        return
    end if

    json = response.Json()
    if not IsAssociativeArray(json)
        JobErrorNoTelemetry("Invalid storyboards response")
        return
    end if

    preview = StoryboardUtils.GetPreviewFrames(json.storyboards, instance, 8, 160)
    if preview = invalid
        JobErrorNoTelemetry("No usable storyboard")
        return
    end if
    JobSuccessData(preview)
end function
