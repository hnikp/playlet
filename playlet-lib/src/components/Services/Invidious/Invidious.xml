<component name="Invidious" extends="Node">
    <interface>
        <field id="applicationInfo" type="node" />
        <field id="preferences" type="node" />
        <field id="webServer" type="node" />
        <field id="profilesService" type="node" />

        <field id="apiDefinitions" type="assocarray" />

        <!-- Subscription list cache, see SubscriptionCache.bs -->
        <field id="subscriptionsCache" type="assocarray" />
        <!-- Set after a successful subscribe/unsubscribe: { ucid, isSubscribed } -->
        <field id="subscriptionChanged" type="assocarray" alwaysNotify="true" />

        <function name="GetInstance" />
        <function name="GetInvidiousInstance" />
    </interface>
</component>