' ButtonRow @SGNode suite — instantiates just the row, sets its scalar input fields, and asserts the derived
' visibility + the virtual-focus highlight on the child buttons (no coordinator, no Video node).
import "pkg:/source/utils/Locale.bs"

namespace Tests

    @SGNode("ButtonRow")
    @suite
    class ButtonRowTests extends Rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.transportMode = TransportController.Mode.Idle
            m.top.rowFocused = false
            m.top.focusedIndex = 0
            m.top.playing = true
        end function

        @describe("visibility + layout")

        @it("visible at idle (the chrome group's opacity fade does the chrome-gating)")
        function _()
            m.top.transportMode = TransportController.Mode.Idle
            m.assertTrue(m.top.visible)
        end function

        @it("hidden during a transport (gets out of the way of seeking)")
        function _()
            m.top.transportMode = TransportController.Mode.Scrub
            m.assertFalse(m.top.visible)
        end function

        @it("exposes its button count and auto-positions the clusters (centered + right-aligned)")
        function _()
            m.assertEqual(m.top.buttonCount, 6)
            ' one 42px button in the center cluster: centered on 640 -> x=619. Five in the right cluster (audio,
            ' captions, comments, menu, minimize: 5*42+4*20=290px) right-aligned to 1212 -> x=922. Pins the
            ' ClusterWidth math so a drift in BUTTON_WIDTH/itemSpacings can't silently de-center.
            m.assertEqual(m.top.findNode("CenterCluster").translation[0], 619.0)
            m.assertEqual(m.top.findNode("RightCluster").translation[0], 922.0)
        end function

        @describe("virtual-focus highlight")

        @it("no button is focused until the row holds focus")
        function _()
            m.top.rowFocused = false
            m.assertFalse(m.top.findNode("PlayPauseButton").focused)
            m.assertFalse(m.top.findNode("MenuButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
        end function

        @it("the focused button follows focusedIndex while the row holds focus")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = 0
            m.assertTrue(m.top.findNode("PlayPauseButton").focused)
            m.assertFalse(m.top.findNode("MenuButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
            m.top.focusedIndex = 1
            m.assertFalse(m.top.findNode("PlayPauseButton").focused)
            m.assertTrue(m.top.findNode("AudioButton").focused)
            m.top.focusedIndex = 2
            m.assertTrue(m.top.findNode("CaptionsButton").focused)
            m.top.focusedIndex = 3
            m.assertTrue(m.top.findNode("CommentsButton").focused)
            m.top.focusedIndex = 4
            m.assertTrue(m.top.findNode("MenuButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
            m.top.focusedIndex = 5
            m.assertFalse(m.top.findNode("MenuButton").focused)
            m.assertTrue(m.top.findNode("MinimizeButton").focused)
        end function

        @describe("nudge")

        @it("nudge pulses the focused button's animation")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = 5
            anim = m.top.findNode("MinimizeButton").findNode("nudgeAnim")
            anim.control = "stop"
            m.top.nudge = true
            m.assertEqual(anim.control, "start")
        end function

        @it("a nudge with an out-of-range focusedIndex is a safe no-op")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = 6 ' one past minimize
            playAnim = m.top.findNode("PlayPauseButton").findNode("nudgeAnim")
            minimizeAnim = m.top.findNode("MinimizeButton").findNode("nudgeAnim")
            playAnim.control = "stop"
            minimizeAnim.control = "stop"
            m.top.nudge = true
            m.assertEqual(playAnim.control, "stop")
            m.assertEqual(minimizeAnim.control, "stop")
        end function

        @describe("caption")

        @it("no caption until the row holds focus")
        function _()
            m.top.rowFocused = false
            m.assertFalse(m.top.findNode("captionLabel").visible)
        end function

        @it("names the focused button above it, Pause/Play following the play state")
        function _()
            caption = m.top.findNode("captionLabel")
            m.top.rowFocused = true
            m.top.focusedIndex = 0
            m.assertTrue(caption.visible)
            m.assertEqual(caption.text, Tr(Locale.VideoPlayer.Pause))
            m.assertTrue(caption.translation[1] < 560, "above the buttons")
            m.top.playing = false
            m.assertEqual(caption.text, Tr(Locale.Buttons.Play))
            m.top.focusedIndex = 1
            m.assertEqual(caption.text, Tr(Locale.PlayerMenu.AudioTrack))
            m.top.focusedIndex = 3
            m.assertEqual(caption.text, Tr(Locale.Buttons.Comments))
            m.top.focusedIndex = 4
            m.assertEqual(caption.text, Tr(Locale.VideoPlayer.More))
            m.top.rowFocused = false
            m.assertFalse(caption.visible)
        end function

        @it("keeps the last button's caption inside the trackbar's right edge")
        function _()
            caption = m.top.findNode("captionLabel")
            m.top.rowFocused = true
            m.top.focusedIndex = 5
            m.assertEqual(caption.text, Tr(Locale.PlayerMenu.PictureInPicture))
            right = caption.translation[0] + caption.boundingRect().width
            m.assertTrue(right <= 1212.5, "caption ends at " + right.ToStr())
        end function

        @describe("play/pause icon tracks the play state")

        @it("shows the pause icon while playing, the play icon while paused")
        function _()
            ' toggleState=false shows icon2 (pause); =true shows icon (play).
            m.top.playing = true
            m.assertFalse(m.top.findNode("PlayPauseButton").toggleState)
            m.top.playing = false
            m.assertTrue(m.top.findNode("PlayPauseButton").toggleState)
        end function

    end class

end namespace
