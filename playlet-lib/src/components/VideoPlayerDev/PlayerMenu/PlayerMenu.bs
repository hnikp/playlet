import "pkg:/components/Subscription/SubscriptionUtils.bs"
import "pkg:/components/VideoPlayerDev/PlayerMenu/PlayerMenuItems.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/RtlText.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.titleLabel = m.top.findNode("titleLabel")
    m.list = m.top.findNode("list")
    m.list.ObserveField("itemSelected", FuncName(OnItemSelected))
    m.page = "" ' "" = root, else the id of the sub page (quality, speed, captions)
    m.directPage = false ' the sub page was opened directly (an overlay button), without the root page
    m.rootFocus = 0
    m.items = []
    m.subscriptionKnown = false
end function

function OnNodeReady()
end function

function OnFocusChange() as void
    if m.top.focus
        NodeSetFocus(m.list, true)
    end if
end function

' The player opened the menu: show the root page (or the requested sub page), and fetch the subscription state
function OnOpen() as void
    m.page = ValidString(m.top.page)
    m.directPage = m.page <> ""
    m.rootFocus = 0
    m.subscriptionKnown = false
    Render()
    m.list.jumpToItem = 0
    if m.directPage
        JumpToSelected()
    end if

    CancelSubscriptionJobs()
    state = ValidAssociativeArray(m.top.state)
    if state.loggedIn = true and ValidString(state.authorId) <> ""
        m.fetchJob = SubscriptionUtils.FetchStatus(m.top, state.authorId, m.invidious, m.profilesService, m.jobQueue)
    end if
end function

function OnSubscriptionStatus()
    m.subscriptionKnown = true
    Render()
end function

function Render() as void
    state = ValidAssociativeArray(m.top.state)
    if m.subscriptionKnown
        state.isSubscribed = m.top.isSubscribed
    else
        state.isSubscribed = invalid
    end if

    RtlText.ApplyToLabel(m.titleLabel, ValidString(state.title), "font:MediumBoldSystemFont", true, 24)
    if m.page = ""
        items = PlayerMenuItems.RootItems(state)
    else
        items = PlayerMenuItems.SubItems(m.page, state)
        if items = invalid
            m.page = ""
            items = PlayerMenuItems.RootItems(state)
        end if
    end if

    focus = m.list.itemFocused
    m.items = items
    content = CreateObject("roSGNode", "ContentNode")
    for each item in items
        node = content.createChild("ContentNode")
        node.title = item.title
    end for
    m.list.content = content
    if focus >= 0 and focus < items.Count()
        m.list.jumpToItem = focus
    end if
end function

function OnItemSelected() as void
    item = m.items[m.list.itemSelected]
    if item = invalid
        return
    end if

    if m.page <> ""
        ' a value in a sub page: apply it and go back to the root page (or close, if the page was opened directly)
        m.top.action = { id: item.id, value: item.value }
        if m.directPage
            m.top.closed = true
        else
            ShowRoot()
        end if
        return
    end if

    if item.id = "subscribe"
        ToggleSubscription()
        return
    end if

    subItems = PlayerMenuItems.SubItems(item.id, ValidAssociativeArray(m.top.state))
    if subItems <> invalid
        m.rootFocus = m.list.itemFocused
        m.page = item.id
        Render()
        JumpToSelected()
        return
    end if

    m.top.action = { id: item.id }
end function

' Focuses the current value of a sub page
function JumpToSelected()
    for i = 0 to m.items.Count() - 1
        if m.items[i].selected = true
            m.list.jumpToItem = i
            exit for
        end if
    end for
end function

function ShowRoot()
    m.page = ""
    Render()
    m.list.jumpToItem = m.rootFocus
end function

function ToggleSubscription() as void
    if not m.subscriptionKnown
        return
    end if
    state = ValidAssociativeArray(m.top.state)
    CancelSubscriptionJobs()
    m.subscribeJob = SubscriptionUtils.SetSubscribed(m.top, ValidString(state.authorId), not m.top.isSubscribed, m.invidious, m.profilesService, m.jobQueue)
    if m.subscribeJob <> invalid
        m.subscriptionKnown = false
        Render()
    end if
end function

function CancelSubscriptionJobs()
    if m.fetchJob <> invalid
        m.fetchJob.cancel = true
        m.fetchJob = invalid
    end if
    if m.subscribeJob <> invalid
        m.subscribeJob.cancel = true
        m.subscribeJob = invalid
    end if
end function

' Modal: consumes every key except the playback keys (which keep controlling the video).
function OnKeyEvent(key as string, press as boolean) as boolean
    if key = RemoteKeys.Play or key = RemoteKeys.Pause or key = RemoteKeys.PlayOnly
        return false
    end if

    if press
        if key = RemoteKeys.Back or key = RemoteKeys.Left
            if m.page <> "" and m.directPage
                m.top.closed = true
            else if m.page <> ""
                ShowRoot()
            else if key = RemoteKeys.Back
                m.top.closed = true
            end if
        end if
    else if key = RemoteKeys.Options
        ' on release, like the app's Options handling, so the release doesn't reach it
        m.top.closed = true
    end if
    return true
end function
