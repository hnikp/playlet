<!-- The in-player menu (Options (*) or the ⋮ button): channel, subscribe, quality, speed, captions, comments and
     a few playback settings. A side panel over the video; the player sets `state` (see PlayerMenuItems.bs) and
     `open`, and handles `action` ({ id, value }). Subscribing is handled here. Sets `closed` on Back. -->
<component name="PlayerMenu" extends="Group" includes="AutoBind,Focus">
    <interface>
        <field id="state" type="assocarray" onChange="Render" />
        <!-- the page to open on: "" = root, or a sub page id (audio, captions...) opened directly from an overlay
             button; picking a value or going back then closes the menu instead of showing the root page -->
        <field id="page" type="string" />
        <field id="open" type="boolean" alwaysNotify="true" onChange="OnOpen" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- SubscriptionUtils target -->
        <field id="isSubscribed" type="boolean" alwaysNotify="true" onChange="OnSubscriptionStatus" />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="profilesService" type="node" bind="/ProfilesService" />
        <field id="jobQueue" type="node" bind="/JobQueue" />
    </interface>
    <children>
        <!-- the player isn't scaled for overscan: the panel reaches the screen edge, its text ends at x 1212 -->
        <Rectangle
            translation="[762,0]"
            width="518"
            height="720"
            color="#141414F2">
            <Label
                id="titleLabel"
                translation="[30,30]"
                width="420"
                font="font:MediumBoldSystemFont" />
            <MarkupList
                id="list"
                translation="[30,90]"
                itemSize="[420,50]"
                itemComponentName="ContextMenuRow"
                vertFocusAnimationStyle="floatingFocus"
                numRows="11" />
        </Rectangle>
    </children>
</component>
