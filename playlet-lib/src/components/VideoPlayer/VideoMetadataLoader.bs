import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.bs"
import "pkg:/components/Services/Innertube/InnertubeService.bs"
import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/source/utils/CancellationUtils.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/MessagePortUtils.bs"
import "pkg:/source/utils/StringUtils.bs"
import "pkg:/source/utils/Types.bs"

' Fetches a video's metadata from the selected backend. Shared by VideoContentJob (playback)
' and VideoPreviewJob (thumbnail preview). Must run in a job (task thread).
namespace VideoMetadataLoader

    ' Returns { metadata, playletFields }, or { cancel: true }, or { error: string }.
    ' metadata may be invalid when the request failed. playletFields (potAttached, potSource,
    ' loggedIn) is set for the playlet backend when metadata is an AA, invalid otherwise.
    function Load(videoId as string, backend as string, service as Invidious.InvidiousService, innertubeNode as object, loungeServiceNode as object, profilesService as object, cancellation as object) as object
        if backend <> "playlet"
            return {
                metadata: service.GetVideoMetadata(videoId, { cancellation: cancellation })
                playletFields: invalid
            }
        end if

        sessionData = VideoMetadataLoader.GetSessionData(innertubeNode, cancellation)
        if sessionData.cancel = true
            return { cancel: true }
        end if
        if sessionData.error <> invalid
            return { error: sessionData.error }
        end if

        accessToken = invalid
        onBehalfOfUser = invalid
        profileNode = invalid
        profile = profilesService.currentProfile
        if profile <> invalid and profile.type = "youtube"
            auth = ProfileContentAuthTokenUtils.EnsureFreshAccessToken(profile)
            if auth.state = ProfileContentAuthTokenUtils.AccessTokenState.NeedsReauth
                return { error: Locale.Dialogs.ProfileNeedsReauthMessage }
            end if
            if auth.state = ProfileContentAuthTokenUtils.AccessTokenState.Ok
                accessToken = auth.token
                onBehalfOfUser = auth.activeIdentifyToken
                profileNode = profile
            end if
        end if

        metadata = InnertubeService.GetVideoMetadata(videoId, {
            "cancellation": cancellation
            "credentialTransferToken": loungeServiceNode.credentialTransferToken
            "visitorData": sessionData.visitorData
            "livingRoomPoTokenId": sessionData.livingRoomPoTokenId
            "accessToken": accessToken
            "onBehalfOfUser": onBehalfOfUser
            "profileNode": profileNode
            "profilesService": profilesService
        })

        playletFields = invalid
        if IsAssociativeArray(metadata)
            playletFields = {
                potAttached: ValidBool(metadata.potAttached)
                potSource: ValidString(metadata.potSource)
                loggedIn: not StringUtils.IsNullOrEmpty(accessToken)
            }
        end if

        return {
            metadata: metadata
            playletFields: playletFields
        }
    end function

    function GetSessionData(innertubeNode as object, cancellation as object) as object
        sessionData = innertubeNode.sessionData
        if VideoMetadataLoader.SessionDataComplete(sessionData)
            return sessionData
        end if

        callback = innertubeNode.callFunc("EnsureSessionDataJob", invalid)

        port = CreateObject("roMessagePort")
        MessagePortUtils.ObserveFieldScopedExSafe(innertubeNode, "sessionData", port)
        MessagePortUtils.ObserveFieldScopedExSafe(callback, "done", port)
        CancellationUtils.ObserveCancellationScoped(cancellation, port)

        cancelled = false
        while not VideoMetadataLoader.SessionDataComplete(innertubeNode.sessionData) and callback.done <> true
            message = wait(30000, port)
            if message = invalid
                exit while
            end if
            if CancellationUtils.IsCancellationEvent(cancellation, message)
                cancelled = true
                exit while
            end if
        end while

        innertubeNode.unobserveFieldScoped("sessionData")
        callback.unobserveFieldScoped("done")
        CancellationUtils.UnobserveCancellationScoped(cancellation)

        if cancelled
            return {
                cancel: true
            }
        end if

        sessionData = innertubeNode.sessionData
        if VideoMetadataLoader.SessionDataComplete(sessionData)
            return sessionData
        end if

        return {
            error: "Failed to get session data. Please try again later."
        }
    end function

    function SessionDataComplete(sessionData as object) as boolean
        return IsAssociativeArray(sessionData) and not StringUtils.IsNullOrEmpty(sessionData.visitorData) and not StringUtils.IsNullOrEmpty(sessionData.livingRoomPoTokenId)
    end function

end namespace
