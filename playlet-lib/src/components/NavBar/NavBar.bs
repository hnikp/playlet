import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.lastIsInFocusChain = false
    m.top.focusable = true
    m.sideBar = m.top.findNode("SideBar")
    m.background = m.top.findNode("Background")
    m.itemsList = m.top.findNode("ItemsList")

    m.fadeAnimation = m.top.findNode("FadeAnimation")
    m.sideBarFadeInterpolator = m.top.findNode("SideBarFadeInterpolator")
    m.logoBarFadeInterpolator = m.top.findNode("LogoFadeInterpolator")
    m.backgroundFadeInterpolator = m.top.findNode("BackgroundFadeInterpolator")
end function

function OnNodeReady()
    m.itemFocusedObserved = false
    m.ignoreUnfocusedItemFocus = false
    m.itemsList.observeField("focusedChild", FuncName(OnListFirstFocus))

    ' Keep every item: the ones with a preference (AI Search, History, Bookmarks, Remote, Info) are only shown when switched on
    m.allItems = []
    content = m.top.content
    if content <> invalid
        m.allItems = content.getChildren(-1, 0)
    end if

    ' Remember the initial item by screen name, since hidden items shift the indices
    m.initialScreen = ""
    initialFocus = m.top.initialFocus
    if initialFocus > -1 and initialFocus < m.allItems.Count()
        m.initialScreen = m.allItems[initialFocus].screen
    end if

    ObserveNavPreferences()
    ApplyNavItemsVisibility()
    m.lastItemFocused = m.itemsList.itemFocused

    ' NavBar should be resized after the content is changed (here and in OnNavPreferenceChange)
    ResizeNavBar()
end function

function ObserveNavPreferences() as void
    if m.preferences = invalid
        return
    end if

    observed = {}
    for each item in m.allItems
        key = item.preference
        if key <> "" and not observed.DoesExist(key)
            observed[key] = true
            m.preferences.observeFieldScoped(key, FuncName(OnNavPreferenceChange))
        end if
    end for
end function

function IsNavItemVisible(item as object) as boolean
    key = item.preference
    if key = ""
        return true
    end if
    if m.preferences = invalid
        return false
    end if
    return m.preferences[key] = true
end function

' Rebuilds the list content from the visible items. Returns false if nothing changed.
function ApplyNavItemsVisibility() as boolean
    content = m.itemsList.content
    if content = invalid
        return false
    end if

    visibleItems = []
    for each item in m.allItems
        if IsNavItemVisible(item)
            visibleItems.push(item)
        end if
    end for

    currentItems = content.getChildren(-1, 0)
    if currentItems.Count() = visibleItems.Count()
        same = true
        for i = 0 to visibleItems.Count() - 1
            if not currentItems[i].isSameNode(visibleItems[i])
                same = false
                exit for
            end if
        end for
        if same
            return false
        end if
    end if

    content.removeChildrenIndex(content.getChildCount(), 0)
    content.appendChildren(visibleItems)
    return true
end function

function FindNavItemIndex(screenName as string) as integer
    if screenName = ""
        return -1
    end if

    content = m.itemsList.content
    if content = invalid
        return -1
    end if

    childCount = content.getChildCount()
    for i = 0 to childCount - 1
        if content.getChild(i).screen = screenName
            return i
        end if
    end for
    return -1
end function

' A Show page switch changed (from Settings, or remotely from the web app)
function OnNavPreferenceChange() as void
    ' The screen currently shown, looked up before the indices shift
    currentScreen = ""
    currentItem = GetItem(m.lastItemFocused)
    if currentItem <> invalid
        currentScreen = currentItem.screen
    end if

    ' Changing the content may move itemFocused: don't let that show/hide screens
    wasObserved = m.itemFocusedObserved
    if wasObserved
        m.itemsList.unobserveField("itemFocused")
    end if

    if not ApplyNavItemsVisibility()
        if wasObserved
            m.itemsList.observeField("itemFocused", FuncName(OnItemFocused))
        end if
        return
    end if

    ResizeNavBar()

    if not wasObserved
        ' Never focused yet, so no screen is shown: OnListFirstFocus jumps to the initial screen by name
        m.lastItemFocused = m.itemsList.itemFocused
        return
    end if

    newIndex = FindNavItemIndex(currentScreen)
    if newIndex = -1
        ' The shown screen was hidden: fall back to Home
        screen = m.appController@.GetRootScreen(currentScreen)
        hadFocus = screen <> invalid and screen.isInFocusChain()
        m.appController@.HideRootScreen(currentScreen)

        newIndex = FindNavItemIndex("HomeScreen")
        if newIndex = -1
            newIndex = 0
        end if
        item = GetItem(newIndex)
        if item <> invalid
            m.appController@.ShowRootScreen(item.screen)
        end if

        if hadFocus
            NodeSetFocus(m.top, true)
        end if
    end if

    m.itemsList.jumpToItem = newIndex
    m.lastItemFocused = newIndex
    ' The list may still settle its focus after the rebuild; snap it back while the user is on a screen
    m.ignoreUnfocusedItemFocus = true
    m.itemsList.observeField("itemFocused", FuncName(OnItemFocused))
end function

function ResizeNavBar() as void
    content = m.top.content
    if content = invalid
        return
    end if

    component = CreateObject("roSGNode", m.itemsList.itemComponentName)
    itemSize = m.itemsList.itemSize
    minWidth = itemSize[0]
    items = content.getChildren(-1, 0)
    for each item in items
        component.itemContent = item
        rect = component.boundingRect()
        ' Add 35 to account for padding
        width = rect.width + 35
        if width > minWidth
            minWidth = width
        end if
    end for
    m.itemsList.itemSize = [minWidth, itemSize[1]]
    offset = minWidth - m.background.width + 30
    m.top.screenOffset = offset
    m.sideBar.width = offset
end function

function OnListFirstFocus() as void
    if not m.itemsList.hasFocus()
        return
    end if

    m.itemsList.unobserveField("focusedChild")
    initialFocus = FindNavItemIndex(m.initialScreen)
    if initialFocus > -1
        m.itemsList.jumpToItem = initialFocus
    end if
    m.itemFocusedObserved = true
    m.itemsList.observeField("itemFocused", FuncName(OnItemFocused))
    m.top.observeField("focusedChild", FuncName(OnFocusedChildChange))
end function

function OnFocusedChildChange() as void
    isInFocusChain = m.top.isInFocusChain()
    if m.lastIsInFocusChain = isInFocusChain
        return
    end if

    m.lastIsInFocusChain = isInFocusChain

    m.sideBar.visible = isInFocusChain

    if isInFocusChain
        m.screensContainer.animateToPosition = m.top.screenOffset
    else
        m.screensContainer.animateToPosition = 0
    end if

    m.fadeAnimation.control = "stop"
    m.sideBarFadeInterpolator.reverse = not isInFocusChain
    m.logoBarFadeInterpolator.reverse = not isInFocusChain
    m.backgroundFadeInterpolator.reverse = not isInFocusChain
    m.fadeAnimation.control = "start"
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    NodeSetFocus(m.itemsList, true)
end function

function OnItemFocused() as void
    index = m.itemsList.itemFocused
    if m.ignoreUnfocusedItemFocus
        if not m.itemsList.hasFocus()
            if index <> m.lastItemFocused
                m.itemsList.jumpToItem = m.lastItemFocused
            end if
            return
        end if
        m.ignoreUnfocusedItemFocus = false
    end if

    item = GetItem(index)
    if item = invalid
        return
    end if

    if m.lastItemFocused <> index
        UnfocusItem(m.lastItemFocused)
    end if
    m.lastItemFocused = index

    m.appController@.ShowRootScreen(item.screen)
end function

' Brings the nav page of screenName to the front, as if the user selected it in the menu
' (used by the web app, e.g. /api/ai-search). Views pushed on top (video page, channel...)
' are closed. Returns the screen node, or invalid if the page is hidden or unknown.
function FocusScreen(screenName as string) as object
    index = FindNavItemIndex(screenName)
    if index = -1
        return invalid
    end if

    ' Close the views pushed on top of the root (the root is the first child of the stack)
    stack = m.appController.stack
    while stack <> invalid and stack.getChildCount() > 1
        topScreen = stack.getChild(stack.getChildCount() - 1)
        m.appController@.PopScreen()
        if topScreen.hasField("dispose")
            topScreen.dispose = true
        end if
    end while

    if not m.itemFocusedObserved
        ' The list never had focus: OnListFirstFocus will jump to this item
        m.initialScreen = screenName
    else if index <> m.lastItemFocused
        UnfocusItem(m.lastItemFocused)
        m.lastItemFocused = index
        m.itemsList.jumpToItem = index
        ' The list moves its focus while the screen has the focus: OnItemFocused must not undo it
        m.ignoreUnfocusedItemFocus = true
    end if

    m.appController@.ShowRootScreen(screenName)
    screen = m.appController@.GetRootScreen(screenName)
    if screen <> invalid and screen.focusable
        NodeSetFocus(screen, true)
    end if
    return screen
end function

function UnfocusItem(index as integer) as void
    item = GetItem(index)
    if item = invalid
        return
    end if

    m.appController@.HideRootScreen(item.screen)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if key <> RemoteKeys.Right or not press
        return false
    end if

    item = GetItem(m.itemsList.itemFocused)
    if item = invalid
        return false
    end if

    screen = m.appController@.GetRootScreen(item.screen)
    if screen = invalid or not screen.focusable
        return false
    end if

    NodeSetFocus(screen, true)
    return true
end function

function GetItem(index as integer) as dynamic
    content = m.itemsList.content
    if content = invalid
        return invalid
    end if

    childCount = content.getChildCount()
    if childCount = 0 or index < 0 or index >= childCount
        return invalid
    end if

    return content.getChild(index)
end function
