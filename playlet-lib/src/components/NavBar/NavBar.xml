<component name="NavBar" extends="Group" includes="AutoBind,Focus">
    <interface>
        <field id="screensContainer" type="node" />
        <field id="appController" type="node" />
        <field id="content" type="node" alias="ItemsList.content" />
        <field id="itemsList" type="node" bind="./ItemsList" />
        <field id="preferences" type="node" bind="/Preferences" />
        <field id="initialFocus" type="int" value="-1" />
        <field id="screenOffset" type="float" value="170" />
        <!-- Brings the nav page of a screen to the front (closing pushed views), focuses it, and returns the screen node (invalid if hidden) -->
        <function name="FocusScreen" />
    </interface>

    <children>
        <Rectangle
            id="SideBar"
            width="170"
            height="720"
            color="#242424"
            opacity="0.9"
            translation="[62,0]"
            visible="false">
        </Rectangle>

        <Rectangle
            id="Background"
            height="720"
            width="62"
            color="#242424"
            opacity="0.9">

            <Poster
                id="LogoFav"
                width="42"
                height="55"
                translation="[16, 35]"
                uri="pkg:/images/logo-fav.png" />
            <Poster
                id="Logo"
                width="123"
                height="58"
                translation="[0, 31]"
                opacity="0"
                uri="pkg:/images/logo-dark.png">
                <AppVersionLabel
                    fontUri="font:BoldSystemFontFile"
                    fontSize="16"
                    translation="[16, 65]" />
            </Poster>

            <MarkupList
                id="ItemsList"
                itemSize="[190,50]"
                itemComponentName="NavBarComponent"
                focusFootprintBitmapUri=""
                focusBitmapUri="pkg:/images/white.$$RES$$.9.png"
                focusBitmapBlendColor="0xFF1C30FF"
                vertFocusAnimationStyle="floatingFocus"
                numRows="11"
                scrollSpeed="99999"
                itemSpacing="[0, 5]"
                translation="[13, 145]">
            </MarkupList>
        </Rectangle>

        <Animation
            id="FadeAnimation"
            duration="0.2">
            <FloatFieldInterpolator
                id="SideBarFadeInterpolator"
                key="[0.0, 0.5, 1.0]"
                keyValue="[0.0, 0.5, 1.0]"
                fieldToInterp="SideBar.opacity" />
            <FloatFieldInterpolator
                id="LogoFadeInterpolator"
                key="[0.0, 0.5, 1.0]"
                keyValue="[0.0, 0.5, 1.0]"
                fieldToInterp="Logo.opacity" />
            <FloatFieldInterpolator
                id="BackgroundFadeInterpolator"
                key="[0.0, 0.5, 1.0]"
                keyValue="[0.9, 0.95, 1.0]"
                fieldToInterp="Background.opacity" />
        </Animation>
    </children>
</component>