import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/SensitivePreferences.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.top.focusable = true
    m.top.itemSpacings = [8]

    m.button = m.top.findNode("button")
    AdjustButtonLabel(m.button)

    m.button.observeField("buttonSelected", FuncName(ShowEditKeyboard))
end function

function AdjustButtonLabel(button as object) as void
    children = button.getChildren(-1, 0)
    for each child in children
        if child.isSubtype("Label") and child.hasField("horizAlign")
            child.observeField("horizAlign", FuncName(OnButtonLabelHorizAlignChanged))
            child.horizAlign = "left"
            return
        end if
    end for
end function

function OnButtonLabelHorizAlignChanged(event as object)
    label = event.getRoSGNode()
    if label.horizAlign <> "left"
        label.horizAlign = "left"
    end if
end function

function BindPreference(preferences as object, key as string)
    if m.preferences <> invalid and m.key <> invalid
        m.preferences.unobserveFieldScoped(m.key)
    end if

    m.preferences = preferences
    m.key = key

    if preferences <> invalid and key <> invalid
        preferences.observeFieldScoped(key, FuncName(OnPreferenceChange))
        OnPreferenceChange()
    end if
end function

function OnPreferenceChange()
    m.top.value = m.preferences[m.key]
end function

function OnValueChange() as void
    UpdateButtonText()

    if m.preferences = invalid or m.key = invalid
        return
    end if

    m.preferences[m.key] = m.top.value
end function

function UpdateButtonText()
    if m.top.sensitive
        m.button.text = SensitivePreferences.Mask(m.top.value)
    else
        m.button.text = m.top.value
    end if
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if

    NodeSetFocus(m.button, true)
end function

function ShowEditKeyboard()
    keyboardDialog = createObject("roSGNode", "StandardKeyboardDialog")
    keyboardDialog.title = m.top.displayText
    keyboardDialog.message = [m.top.description]
    if m.top.sensitive
        ' Never show the saved value on the TV: OK with an empty text keeps it, Clear removes it
        keyboardDialog.text = ""
        keyboardDialog.buttons = [Tr(Locale.Buttons.OK), Tr(Locale.Buttons.Cancel), Tr(Locale.Buttons.Clear)]
    else
        keyboardDialog.text = m.top.value
        keyboardDialog.buttons = [Tr(Locale.Buttons.OK), Tr(Locale.Buttons.Cancel)]
    end if
    keyboardDialog.observeField("buttonSelected", FuncName(OnKeyboardButton))

    m.top.getScene().dialog = keyboardDialog
end function

function OnKeyboardButton(event as object)
    keyboard = event.getRoSGNode()
    buttonSelected = keyboard.buttonSelected
    if buttonSelected = 0
        if not m.top.sensitive or keyboard.text <> ""
            m.top.value = keyboard.text
        end if
    else if buttonSelected = 2 and m.top.sensitive
        m.top.value = ""
    end if
    keyboard.close = true
end function
