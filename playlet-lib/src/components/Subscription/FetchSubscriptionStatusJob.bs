import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.bs"
import "pkg:/components/Services/Innertube/InnertubeService.bs"
import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/components/Subscription/SubscriptionCache.bs"
import "pkg:/source/utils/CancellationUtils.bs"

@job("FetchSubscriptionStatusJob")
function ExecuteJob() as void
    input = JobGetInput()

    target = input.target
    ucid = input.ucid
    invidiousNode = input.invidious
    profile = input.profile

    if JobIsCancelled()
        JobCancel()
        return
    end if

    cancellation = JobGetCancellation()

    auth = ProfileContentAuthTokenUtils.EnsureFreshAccessToken(profile)
    if auth.state <> ProfileContentAuthTokenUtils.AccessTokenState.Ok
        JobErrorNoTelemetry("No usable access token to fetch subscription status: " + auth.state)
        return
    end if

    if profile.type = "youtube"
        subscriptionStatus = InnertubeService.GetSubscriptionStatusForChannel(ucid, {
            cancellation: cancellation
            accessToken: auth.token
            onBehalfOfUser: auth.activeIdentifyToken
        })
        ' a cancelled request (the page closed) is not an error, and its target may be gone
        if JobIsCancelled()
            JobCancel()
            return
        end if

        if subscriptionStatus.error <> invalid
            JobError("Failed to fetch subscription status: " + ToString(subscriptionStatus.error))
            return
        end if
        target.isSubscribed = subscriptionStatus.isSubscribed
        return
    end if

    ' Invidious has no per-channel status endpoint: the whole subscription list is needed,
    ' so it is cached for a few minutes on the Invidious node.
    cachedStatus = SubscriptionCache.IsSubscribed(invidiousNode, profile, ucid)
    if cachedStatus <> invalid
        target.isSubscribed = cachedStatus
        return
    end if

    service = new Invidious.InvidiousService(invidiousNode)
    subscriptionsResponse = service.GetSubscriptions(auth, cancellation)
    if JobIsCancelled()
        JobCancel()
        return
    end if
    if not subscriptionsResponse.IsSuccess()
        JobError("Failed to fetch subscriptions: " + subscriptionsResponse.ErrorMessage())
        return
    end if
    subscriptions = subscriptionsResponse.Json()

    ucids = {}
    for each subscription in ValidArray(subscriptions)
        if IsString(subscription.authorId)
            ucids[subscription.authorId] = true
        end if
    end for
    SubscriptionCache.Set(invidiousNode, profile, ucids)

    target.isSubscribed = ucids.DoesExist(ucid)
end function
