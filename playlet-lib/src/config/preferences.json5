        displayText: "Clear cache",
        key: "dev.clear_cache",
        description: "Clear cache from cachefs: and tmp:",
        visibility: "web",
        svelteComponent: "ClearCacheControl",
      },
      {
        displayText: "Clear cache",
        key: "dev.clear_cache",
        description: "Clear cache from cachefs: and tmp:",
