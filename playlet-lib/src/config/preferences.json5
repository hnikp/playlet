[
  {
    displayText: "Playback",
    key: "playback",
    description: "Playback preferences",
    children: [
      {
        displayText: "Autoplay",
        key: "playback.autoplay",
        description: "When you finish a video, another plays automatically",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Preferred quality",
        key: "playback.preferred_quality",
        description: "Preferred video quality",
        type: "string",
        defaultValue: "auto",
        visibility: "tv",
        rokuComponent: "EditQualityControl",
      },
      {
        displayText: "Preferred quality",
        key: "playback.preferred_quality",
        description: "Preferred video quality",
        visibility: "web",
        svelteComponent: "EditQualityControl",
      },
      {
        displayText: "Disable auto-dubbed audio",
        key: "playback.disable_auto_dubbed",
        description: "Remove AI-generated dubbed audio tracks.",
        type: "boolean",
        defaultValue: false,
      },
      {
        displayText: "Queue notifications",
        key: "misc.queue_notifications",
        description: "Show a notification when a video is added to the queue",
        type: "boolean",
        defaultValue: true,
      },
    ],
  },
  {
    displayText: "Backend",
    key: "backend",
    description: "Backend preferences",
    children: [
      {
        displayText: "Selected backend",
        key: "backend.selected",
        description: "The backend used for browsing and playing videos.",
        type: "radio",
        defaultValue: "playlet",
        options: [
          {
            displayText: "Playlet (local)",
            value: "playlet",
          },
          {
            displayText: "Invidious",
            value: "invidious",
          },
        ],
      },
    ],
  },
  {
    displayText: "Content Feed",
    key: "content_feed",
    description: "Feed preferences",
    children: [
      {
        displayText: "Disable Shorts",
        key: "content_feed.disable_shorts",
        description: "Disable short videos.",
        type: "boolean",
        defaultValue: false,
      },
    ],
  },
  {
    displayText: "Browsing",
    key: "browsing",
    description: "Home screen and how videos open",
    children: [
      {
        displayText: "Edit home screen",
        key: "misc.home_screen_layout",
        description: "Enable/disable and reorder sections on the home screen",
        type: "array",
        defaultValue: [
          {
            id: "subscriptions",
            enabled: true,
          },
          {
            id: "recommended",
            enabled: true,
          },
          {
            id: "popular",
            enabled: true,
          },
          {
            id: "playlists",
            enabled: true,
          },
          {
            id: "watch_history",
            enabled: true,
          },
          {
            id: "trending_livestreams",
            enabled: true,
          },
          {
            id: "trending_gaming",
            enabled: true,
          },
          {
            id: "category_news",
            enabled: true,
          },
          {
            id: "category_movies",
            enabled: true,
          },
        ],
        visibility: "tv",
        rokuComponent: "EditHomeScreenControl",
      },
      {
        displayText: "Edit home screen",
        key: "misc.home_screen_layout",
        description: "Enable/disable and reorder sections on the home screen",
        visibility: "web",
        svelteComponent: "EditHomeScreenControl",
      },
      {
        displayText: "Open video page on select",
        key: "misc.ok_opens_video_details",
        description: "Selecting a video opens its page (description, comments, subscribe) instead of playing it right away",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Show AI Search page",
        key: "browsing.show_ai_search",
        description: "Show the AI Search page in the menu",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Show Bookmarks page",
        key: "browsing.show_bookmarks",
        description: "Show the Bookmarks page in the menu",
        type: "boolean",
        defaultValue: false,
      },
      {
        displayText: "Show Remote page",
        key: "browsing.show_remote",
        description: "Show the Remote page (control Playlet from your phone) in the menu",
        type: "boolean",
        defaultValue: false,
      },
      {
        displayText: "Show Info page",
        key: "browsing.show_info",
        description: "Show the Info page (app version and details) in the menu",
        type: "boolean",
        defaultValue: false,
      },
    ],
  },
  {
    displayText: "Thumbnail preview",
    key: "thumbnail_preview",
    description: "What a video's thumbnail shows when it stays focused",
    children: [
      {
        displayText: "Preview type",
        key: "misc.thumbnail_preview_mode",
        description: "When a video stays focused for 2 seconds: play the video in its thumbnail, animate frames from the video, or do nothing",
        type: "radio",
        defaultValue: "video",
        options: [
          {
            displayText: "Off",
            value: "off",
          },
          {
            displayText: "Frames",
            value: "frames",
          },
          {
            displayText: "Video",
            value: "video",
          },
        ],
      },
      {
        displayText: "Preview sound",
        key: "misc.thumbnail_preview_sound",
        description: "Play video previews with sound",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Preview time limit",
        key: "misc.thumbnail_preview_limit",
        description: "Stop a video preview after this many minutes (0 = no limit)",
        type: "number",
        min: 0,
        max: 30,
        defaultValue: 5,
      },
    ],
  },
  {
    displayText: "Weather",
    key: "weather",
    description: "Weather shown under the clock on the main pages",
    children: [
      {
        displayText: "Show weather",
        key: "weather.enabled",
        description: "Show the temperature, sky and chance of rain under the clock",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "City",
        key: "weather.location",
        description: "City to show the weather for, for example München or Tehran",
        type: "string",
        defaultValue: "München",
      },
      {
        displayText: "Temperature unit",
        key: "weather.units",
        description: "Show temperatures in Celsius or Fahrenheit",
        type: "radio",
        defaultValue: "celsius",
        options: [
          {
            displayText: "Celsius",
            value: "celsius",
          },
          {
            displayText: "Fahrenheit",
            value: "fahrenheit",
          },
        ],
      },
    ],
  },
  {
    displayText: "AI search",
    key: "ai_search",
    description: "The AI service that turns a description into video recommendations",
    children: [
      {
        displayText: "AI provider",
        key: "ai_search.provider",
        description: "Service that answers AI searches. Anthropic needs a paid API key from console.anthropic.com; Gemini, Groq and OpenRouter offer free keys",
        type: "radio",
        defaultValue: "anthropic",
        options: [
          {
            displayText: "Anthropic (Claude)",
            value: "anthropic",
          },
          {
            displayText: "Google Gemini",
            value: "gemini",
          },
          {
            displayText: "Groq",
            value: "groq",
          },
          {
            displayText: "OpenRouter",
            value: "openrouter",
          },
          {
            displayText: "Custom (OpenAI-compatible)",
            value: "custom",
          },
        ],
      },
      {
        displayText: "API key",
        key: "ai_search.api_key",
        description: "API key for the AI provider. Easiest to paste from the Playlet web app on your phone",
        type: "string",
        sensitive: true,
        defaultValue: "",
      },
      {
        displayText: "Model",
        key: "ai_search.model",
        description: "Model name. Leave empty to use the provider's default",
        type: "string",
        defaultValue: "",
      },
      {
        displayText: "Server URL",
        key: "ai_search.base_url",
        description: "Only for Custom: an OpenAI-compatible server, for example http://192.168.0.10:11434/v1 for Ollama",
        type: "string",
        defaultValue: "",
      },
    ],
  },
  {
    displayText: "Invidious",
    key: "invidious",
    description: "Invidious preferences",
    children: [
      {
        displayText: "Instance",
        key: "invidious.instance",
        description: "Invidious instance to use. Example: https://example.com. Find more instances at %INVIDIOUS_PUBLIC_INSTANCES%",
        type: "string",
        visibility: "web",
      },
      {
        displayText: "Instance",
        key: "invidious.instance",
        description: "Invidious instance to use. Example: https://example.com",
        visibility: "tv",
        rokuComponent: "InvidiousInstanceControl",
      },
      {
        displayText: "Proxy videos",
        key: "invidious.proxy_videos",
        description: "Proxy videos through the Invidious server. This is useful if videos are geoblocked.",
        type: "radio",
        defaultValue: "if_needed",
        options: [
          {
            displayText: "Always",
            value: "always",
          },
          {
            displayText: "Only if needed",
            value: "if_needed",
          },
          {
            displayText: "Never",
            value: "never",
          },
        ],
      },
    ],
  },
  {
    displayText: "SponsorBlock",
    key: "sponsorblock",
    description: "SponsorBlock preferences",
    children: [
      {
        displayText: "Enabled",
        key: "sponsorblock.enabled",
        description: "Enable SponsorBlock",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Show notifications",
        key: "sponsorblock.show_notifications",
        description: "Show notifications when a segment is skipped",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Categories",
        key: "sponsorblock.categories",
        description: "Configure which segments to skip",
        type: "assocarray",
        visibility: "tv",
        rokuComponent: "SponsorBlockCategoriesControl",
        defaultValue: {
          // TODO:P1 support for exclusive_access and chapter
          // TODO:P1 support for manual skip for poi_highlight
          sponsor: {
            option: "auto_skip",
          },
          selfpromo: {
            option: "manual_skip",
          },
          interaction: {
            option: "manual_skip",
          },
          poi_highlight: {
            option: "show_in_seekbar",
          },
          intro: {
            option: "manual_skip",
          },
          outro: {
            option: "manual_skip",
          },
          preview: {
            option: "manual_skip",
          },
          hook: {
            option: "manual_skip",
          },
          filler: {
            option: "manual_skip",
          },
          music_offtopic: {
            option: "manual_skip",
          },
        },
      },
      {
        displayText: "Categories",
        key: "sponsorblock.categories",
        description: "Configure which segments to skip",
        visibility: "web",
        svelteComponent: "SponsorBlockCategoriesControl",
      },
    ],
  },
  {
    displayText: "Search History",
    key: "search_history",
    description: "Search history preferences",
    children: [
      {
        displayText: "Enable search history",
        key: "search_history.enabled",
        description: "Enable search history",
        type: "boolean",
        defaultValue: true,
      },
      {
        displayText: "Clear search history",
        key: "search_history.clear_search_history",
        description: "Clear search history from Playlet. This affects the search suggestions. This does not affect the watch history on Invidious.",
        visibility: "web",
        svelteComponent: "ClearSearchHistoryControl",
      },
      {
        displayText: "Clear search history",
        key: "search_history.clear_search_history",
        description: "Clear search history from Playlet. This affects the search suggestions. This does not affect the watch history on Invidious.",
        visibility: "tv",
        rokuComponent: "ClearSearchHistoryControl",
      },
      {
        // This one doesn't belong to "search history" but
        // it can be refactored into "search" later.
        displayText: "Search keyboard language",
        key: "search.keyboard_language",
        description: "Preferred language for the on-screen keyboard.",
        // This preference is not visible in the settings, but is used
        // in the search keyboard component.
        visibility: "off",
        type: "radio",
        defaultValue: "en_US",
        options: [
          { displayText: "English", value: "en_US" },
          { displayText: "Deutsch", value: "de_DE" },
          { displayText: "Español", value: "es_ES" },
          { displayText: "Français", value: "fr_FR" },
          { displayText: "Português", value: "pt_BR" },
          { displayText: "Русский", value: "ru_RU" },
        ],
      },
